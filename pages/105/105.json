                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Exercise 6.1",
            "block_bbox": [
                131,
                579,
                306,
                609
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
