        },
        {
            "block_label": "paragraph_title",
            "block_content": "How to Revise: Introductions",
            "block_bbox": [
                92,
                885,
                462,
                914
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
