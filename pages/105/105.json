                    131.0,
                    609.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Once you know it, you will see this shared context-problem-solution pattern in all sorts of academic and professional writing. Start with three op-eds and do the following:",
            "block_bbox": [
                128,
                624,
                783,
                671
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    128.0,
                    624.0
                ],
                [
                    783.0,
                    624.0
                ],
                [
                    783.0,
                    671.0
                ],
                [
                    128.0,
                    671.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Find where the shared context ends and the statement of the problem begins.",
            "block_bbox": [
                141,
                684,
                740,
                706
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    141.0,
                    684.0
                ],
                [
                    740.0,
                    684.0
                ],
                [
                    740.0,
                    706.0
                ],
                [
                    141.0,
                    706.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Find the two parts of the problem: condition or situation and cost or consequence. Decide whether the problem is practical or conceptual.",
            "block_bbox": [
                140,
                712,
                781,
                757
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    140.0,
                    712.0
                ],
                [
                    781.0,
                    712.0
                ],
                [
                    781.0,
                    757.0
                ],
                [
                    140.0,
                    757.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Find the solution.",
            "block_bbox": [
                141,
                764,
                296,
                786
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
