        {
            "block_label": "text",
            "block_content": "The most common intensifier, however, is the absence of a hedge. Without the hedges, Crick and Watson's claim would be more concise but more aggressive. Compare this revision. Words that are stronger than Crick and Watson's are boldfaced, but most of the aggressive tone comes from the absence of hedges:",
            "block_bbox": [
                91,
                368,
                785,
                497
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    91.0,
                    368.0
                ],
                [
                    785.0,
                    368.0
                ],
                [
                    785.0,
                    497.0
