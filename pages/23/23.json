                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If writers whom we judge to be competent in Standard English regularly violate some alleged rule and most careful readers never notice, then the rule has no force. In those cases, it is not writers who should change their usage, but grammarians who should change their rules.",
            "block_bbox": [
                128,
                324,
                784,
                419
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
