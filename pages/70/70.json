        {
            "block_label": "text",
            "block_content": "- We judge a sequence of sentences to be cohesive based on how each sentence ends and the next begins.",
            "block_bbox": [
                118,
                117,
                770,
                167
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
