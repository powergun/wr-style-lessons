                [
                    118.0,
                    167.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- We judge a whole passage to be coherent based on how all the sentences in it cumulatively begin.",
            "block_bbox": [
                117,
                175,
                772,
                225
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
