                    708.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2b. A black hole is created by the collapse of a dead star into a point perhaps no larger than a marble.",
            "block_bbox": [
                113,
                725,
                740,
                775
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
