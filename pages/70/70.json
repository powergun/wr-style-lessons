        {
            "block_label": "text",
            "block_content": "Lesson 3 devoted a few pages to that familiar advice, Avoid passives. If we always did, we would choose sentence 2a, which has an active verb, over sentence 2b, which has a passive one:",
            "block_bbox": [
                79,
                568,
                772,
                646
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
