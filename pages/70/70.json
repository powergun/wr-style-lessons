                [
                    740.0,
                    775.0
                ],
                [
                    113.0,
                    775.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "But we might choose otherwise in context. Consider:",
            "block_bbox": [
                80,
                792,
                529,
                816
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    80.0,
                    792.0
                ],
                [
                    529.0,
                    792.0
                ],
                [
                    529.0,
                    816.0
                ],
                [
                    80.0,
                    816.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": " $ ^{1} $Some astonishing questions about the nature of the universe have been raised by scientists studying black holes in space.  $ ^{2a} $The collapse of a dead star into a point perhaps no larger than a marble creates a black hole.  $ ^{3} $So much matter compressed into so little volume changes the fabric of space around it in puzzling ways.",
            "block_bbox": [
                107,
                828,
                743,
                954
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
