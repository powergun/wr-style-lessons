                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2a. The collapse of a dead star into a point perhaps no larger than a marble creates active a black hole.",
            "block_bbox": [
                113,
                658,
                741,
                708
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    113.0,
