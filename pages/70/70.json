        {
            "block_label": "paragraph_title",
            "block_content": "Cohesion",
            "block_bbox": [
                80,
                315,
                204,
                344
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
