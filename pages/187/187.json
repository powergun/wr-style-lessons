        {
            "block_label": "text",
            "block_content": "Having thus gradually introduced God as a character, Lincoln repeatedly uses the subjects (underlined) of clauses to name God (gold) as a purposeful agent who has, wills, and gives and to name us (pink) as thinking, feeling, moral beings who suppose, discern, ascribe, hope, and pray:",
            "block_bbox": [
                91,
                477,
                784,
                581
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
