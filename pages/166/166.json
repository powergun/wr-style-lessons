                    477.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Now look again at the example with which we began this lesson, that sentence from the Washington Post:",
            "block_bbox": [
                79,
                491,
                772,
                541
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
