                    79.0,
                    541.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Its 11- and 12-year-old players, some from struggling neighborhoods, not only cheered a city challenged by violence but charmed the country with their stellar play and outstanding sportsmanship.",
            "block_bbox": [
                81,
                557,
                742,
                632
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
