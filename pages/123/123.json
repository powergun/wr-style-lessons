    "parsing_res_list": [
        {
            "block_label": "doc_title",
            "block_content": "Lesson 8\nConcision",
            "block_bbox": [
                299,
                185,
                575,
                300
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "global_block_id": 0,
            "global_group_id": 0,
            "block_polygon_points": [
