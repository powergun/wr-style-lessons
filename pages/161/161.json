                    92.0,
                    379.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ Apart from a few mechanical tricks of rhetoric, manner is indissolubly linked to matter; style shapes, and in turn is shaped by, substance.",
            "block_bbox": [
                101,
                392,
                754,
                442
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    101.0,
