                ],
                [
                    754.0,
                    392.0
                ],
                [
                    754.0,
                    442.0
                ],
                [
                    101.0,
                    442.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ It seems frivolous, almost inappropriate, to be stylish about style.",
            "block_bbox": [
                103,
                459,
                638,
                483
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    103.0,
