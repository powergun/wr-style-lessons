        {
            "block_label": "text",
            "block_content": "At the end of a sentence, readers hear special emphasis when a stressed word or phrase balances the sound or meaning of an earlier one. These examples are all from Peter Gay's Style in History:",
            "block_bbox": [
                91,
                152,
                784,
                229
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    91.0,
                    152.0
                ],
                [
                    784.0,
                    152.0
                ],
                [
                    784.0,
                    229.0
                ],
                [
                    91.0,
                    229.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ I have written these essays to anatomize this familiar yet really strange being, style the centaur; the book may be read as an extended critical commentary on Buffon's famous saying that the style is the man.",
            "block_bbox": [
                99,
                241,
                755,
                315
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    99.0,
                    241.0
                ],
                [
                    755.0,
                    241.0
                ],
                [
                    755.0,
                    315.0
                ],
                [
                    99.0,
                    315.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When we hear a stressed word echo an earlier one, these balances become even more emphatic:",
            "block_bbox": [
                92,
                329,
                783,
                379
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    92.0,
