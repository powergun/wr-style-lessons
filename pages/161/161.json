                    90.0,
                    765.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\begin{array}{r}{\\surd\\mathrm{~A~c o n c i s e~s t y l e~}}\\\\ {\\mathrm{~c a n~i m p r o v e~b o t h~}}\\quad\\left\\{\\begin{array}{l}{\\mathrm{~o u r~o w n^{1A}~~t h i n k i n g^{1B}~}}\\\\ {\\mathrm{~a n d~}}\\\\ {\\mathrm{~o u r~r e a d e r s^{\\prime}^{2A}~u n d e r s t a n d i n g.^{2B}~}}\\end{array}\\right\\}}\\end{array} $$ ",
            "block_bbox": [
                183,
