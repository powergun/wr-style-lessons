                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "For example, read this introduction (all these examples are much shorter than typical ones):",
            "block_bbox": [
                79,
                195,
                771,
                246
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
