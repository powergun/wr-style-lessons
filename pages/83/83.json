        },
        {
            "block_label": "text",
            "block_content": "Another kind of complexity is in the meanings of words, especially technical terms. Compare these two passages:",
            "block_bbox": [
                91,
                479,
                783,
                531
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    91.0,
