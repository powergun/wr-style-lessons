        {
            "block_label": "text",
            "block_content": "2a. Philosopher Hannah Arendt's argument that freedom does not exist as an abstraction apart from concrete human action appears in her book The Human Condition.",
            "block_bbox": [
                126,
                190,
                754,
                263
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
