                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2b. In her book The Human Condition, philosopher Hannah Arendt argues that freedom does not exist as an abstraction apart from concrete human action.",
            "block_bbox": [
                126,
                281,
                754,
                331
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
