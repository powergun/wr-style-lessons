                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Most readers prefer 2b because it begins simply with a short introductory phrase followed by a short subject and a specific verb and then moves toward grammatical complexity. We discussed that issue in Lesson 4.",
            "block_bbox": [
                91,
                347,
                784,
                426
            ],
            "block_id": 6,
            "block_order": 5,
