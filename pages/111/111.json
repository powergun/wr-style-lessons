                [
                    92.0,
                    541.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• motivates your readers by stating a problem that they care about",
            "block_bbox": [
                125,
                556,
                699,
                580
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
