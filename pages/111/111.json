                    147.0,
                    491.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The last lesson explained how to create an introduction that does two things:",
            "block_bbox": [
                92,
                518,
                743,
                541
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
