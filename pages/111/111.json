        {
            "block_label": "text",
            "block_content": "One of the most difficult things is the first paragraph. I have spent many months on a first paragraph, and once I get it, the rest just comes out very easily. In the first paragraph you solve most of the problems with your book. The theme is defined, the style, the tone.\n—GABRIEL GARCÍA MÁRQUEZ",
            "block_bbox": [
                147,
                371,
                728,
                491
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "global_block_id": 1,
            "global_group_id": 1,
            "block_polygon_points": [
