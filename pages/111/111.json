            ]
        },
        {
            "block_label": "text",
            "block_content": "Some writers think that by giving the point up front, they risk boring their readers. But that's often a mistake. When, as readers, we are unsure about the point after the introduction, we struggle more than we have to, even when we are reading about something familiar. We are grateful when writers help us grasp their ideas by stating them first and then elaborating.",
            "block_bbox": [
                91,
                732,
                783,
                858
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
