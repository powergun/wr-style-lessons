        {
            "block_label": "text",
            "block_content": "Free Modifiers Like the other modifiers, a free modifier can appear at the end of a clause, but instead of repeating a key word or summing up what went before, it comments on the subject of the closest verb:",
            "block_bbox": [
                91,
                180,
                784,
                258
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
