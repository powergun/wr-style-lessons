                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Readers usually need a comma between a long (four or five words or more) introductory phrase or clause and the subject:",
            "block_bbox": [
                79,
                436,
                770,
                486
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
