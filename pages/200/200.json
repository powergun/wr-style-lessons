        {
            "block_label": "text",
            "block_content": "It is not wrong to put a comma there, but it slows readers down just as you may want them to be picking up speed.",
            "block_bbox": [
                102,
                374,
                770,
                425
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
