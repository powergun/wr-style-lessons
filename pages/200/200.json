                    636.0,
                    922.0
                ],
                [
                    636.0,
                    946.0
                ],
                [
                    79.0,
                    946.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Occasionally, you cannot avoid a long subject, especially if it consists of a list of items and has internal punctuation, like this:",
            "block_bbox": [
                79,
                948,
                772,
                998
            ],
            "block_id": 17,
            "block_order": 16,
            "group_id": 17,
            "global_block_id": 17,
            "global_group_id": 17,
            "block_polygon_points": [
