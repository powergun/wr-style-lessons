        {
            "block_label": "paragraph_title",
            "block_content": "Punctuating Middles",
            "block_bbox": [
                80,
                567,
                348,
                597
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
