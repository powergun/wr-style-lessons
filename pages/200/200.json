        },
        {
            "block_label": "text",
            "block_content": "This is where explanations get messy, because to punctuate inside a grammatical sentence—more specifically, inside a clause—you have to consider not only the grammar of that clause but also the nuances of rhythm, meaning, and emphasis that you want readers to hear in their minds as they read. There are, however, a few reliable rules you should follow.",
            "block_bbox": [
                79,
                611,
                772,
                740
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    79.0,
                    611.0
                ],
                [
                    772.0,
                    611.0
                ],
                [
                    772.0,
                    740.0
                ],
                [
                    79.0,
                    740.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Subject—Verb, Verb—Object",
            "block_bbox": [
                79,
                759,
                389,
                787
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
                [
                    79.0,
                    759.0
                ],
                [
                    389.0,
                    759.0
                ],
                [
                    389.0,
                    787.0
                ],
                [
                    79.0,
                    787.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Do not put a comma between a subject and its verb, no matter how long the subject (nor between the verb and its object). Do not do this:",
            "block_bbox": [
                78,
                795,
                771,
                846
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
                    78.0,
                    795.0
                ],
                [
                    771.0,
                    795.0
                ],
                [
                    771.0,
                    846.0
                ],
                [
                    78.0,
                    846.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A sentence that consists of many complex subordinate clauses and long phrases that all precede a verb may seem to some students to demand a comma somewhere.",
            "block_bbox": [
                114,
                858,
                742,
                908
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
            "global_block_id": 15,
            "global_group_id": 15,
            "block_polygon_points": [
                [
                    114.0,
                    858.0
                ],
                [
                    742.0,
                    858.0
                ],
                [
                    742.0,
                    908.0
                ],
                [
                    114.0,
                    908.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If you keep subjects short, you won't feel that you need a comma.",
            "block_bbox": [
                79,
                922,
                636,
                946
            ],
            "block_id": 16,
            "block_order": 15,
            "group_id": 16,
            "global_block_id": 16,
            "global_group_id": 16,
            "block_polygon_points": [
                [
                    79.0,
                    922.0
                ],
