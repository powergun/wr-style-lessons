        },
        {
            "block_label": "paragraph_title",
            "block_content": "Punctuating the Ends of Sentences",
            "block_bbox": [
                91,
                384,
                526,
                413
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
