        {
            "block_label": "text",
            "block_content": "Above all else, you must know how to punctuate the end of a grammatical sentence. You can signal the end of a grammatical sentence in a number of ways, but signal it you must, because readers have to know where one grammatical sentence stops and the next begins. You can choose to separate pairs of grammatical sentences in ten ways. Three are common.",
            "block_bbox": [
                90,
                427,
                785,
                556
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
