        {
            "block_label": "text",
            "block_content": "Those seven grammatical sentences feel different when punctuated as seven punctuated sentences, though little else has changed. Like other aspects of style, punctuation is a matter less of following rules (although there are some) than of choosing among options: we create different effects through the choices we make.",
            "block_bbox": [
                90,
                255,
                785,
                359
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
