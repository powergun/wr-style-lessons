                [
                    119.0,
                    456.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "He does the same in his next two sentences, which begin clearly but then also slip into abstraction:",
            "block_bbox": [
                79,
                472,
                771,
                521
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    79.0,
                    472.0
                ],
                [
                    771.0,
                    472.0
                ],
                [
                    771.0,
                    521.0
                ],
                [
                    79.0,
                    521.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": " $ \\underline{\\text{These slaves}} $ constituted a peculiar and powerful interest.  $ \\underline{\\text{All}} $ knew that  $ \\underline{\\text{this interest}} $ was, somehow, the cause of the war.",
            "block_bbox": [
                113,
                534,
                742,
                583
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    113.0,
