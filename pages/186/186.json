            ]
        },
        {
            "block_label": "text",
            "block_content": "And  $ \\underline{\\text{the war}} $ came.",
            "block_bbox": [
                82,
                155,
                267,
                177
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    82.0,
                    155.0
                ],
                [
                    266.0,
                    155.0
                ],
                [
                    266.0,
                    176.0
                ],
                [
                    82.0,
                    176.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "How can a war just come? This sentence presents the war not as a consequence of deliberate human action—and therefore something for which someone must be made to take responsibility—but as a phenomenon without explicit cause.",
            "block_bbox": [
                79,
                192,
                772,
                267
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    79.0,
                    192.0
                ],
                [
                    772.0,
                    192.0
                ],
                [
                    772.0,
                    267.0
                ],
                [
                    79.0,
                    267.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Lincoln then gives us an awkward sentence about slavery:",
            "block_bbox": [
                115,
                270,
                614,
                293
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    115.0,
                    270.0
                ],
                [
                    614.0,
                    270.0
                ],
                [
                    614.0,
                    293.0
                ],
                [
                    115.0,
                    293.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": " $ \\underline{\\text{One eighth of the whole population}} $ were colored slaves, not distributed generally over the Union, but localized in the Southern part of it.",
            "block_bbox": [
                112,
                307,
                742,
                356
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    112.0,
                    307.0
                ],
                [
                    742.0,
                    307.0
                ],
                [
                    742.0,
                    356.0
                ],
                [
                    112.0,
                    356.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Through his indirectness, Lincoln holds slavery at a distance. He could have been more direct:",
            "block_bbox": [
                79,
                369,
                772,
                418
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    79.0,
                    369.0
                ],
                [
                    772.0,
                    369.0
                ],
                [
                    772.0,
                    418.0
                ],
                [
                    79.0,
                    418.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Slaves were one eighth of the population, localized in the South.",
            "block_bbox": [
                114,
                433,
                614,
                457
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
