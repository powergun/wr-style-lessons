                    113.0,
                    583.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Lincoln could have written All knew that slavery caused the war, but even that nominalization slavery is too concrete, so he euphemizes it as an interest.",
            "block_bbox": [
                78,
                598,
                771,
                647
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
