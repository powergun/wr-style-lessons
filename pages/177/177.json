                [
                    755.0,
                    1081.0
                ],
                [
                    125.0,
                    1081.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The writers also nominalized important actions (gold) and used passive verbs (pink) when they referred to actions that might alarm you:",
