        {
            "block_label": "paragraph_title",
            "block_content": "The Two Parts of a Problem",
            "block_bbox": [
                79,
                353,
                380,
                379
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
