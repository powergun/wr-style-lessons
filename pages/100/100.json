        {
            "block_label": "paragraph_title",
            "block_content": "Two Kinds of Problems: Practical and Conceptual",
            "block_bbox": [
                79,
                925,
                612,
                952
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
