                    952.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "There are two kinds of problems, and each motivates readers in a different way. You have to write about them differently.",
            "block_bbox": [
                79,
                960,
                770,
                1010
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    79.0,
                    960.0
                ],
                [
                    770.0,
                    960.0
                ],
                [
                    770.0,
                    1010.0
                ],
                [
                    79.0,
                    1010.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- A practical problem concerns a condition or situation in the world and demands an action as its solution. That people often try to recycle things they can't is a practical problem.",
            "block_bbox": [
                118,
                1024,
                772,
                1100
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
                [
                    118.0,
                    1024.0
                ],
                [
                    772.0,
                    1024.0
                ],
                [
                    772.0,
                    1100.0
                ],
                [
                    118.0,
                    1100.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- A conceptual problem concerns what we think about something and demands a change in understanding as its solution. That we don't know how best to discourage this practice is a conceptual problem.",
            "block_bbox": [
                117,
                1108,
                771,
                1185
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
