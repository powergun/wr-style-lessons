                    140.0,
                    432.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Are your subjects too long?",
            "block_bbox": [
                142,
                439,
                373,
                460
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
