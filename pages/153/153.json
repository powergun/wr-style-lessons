                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Do you interrupt the connection between subject and verb, or verb and object?",
            "block_bbox": [
                140,
                467,
                749,
                488
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
