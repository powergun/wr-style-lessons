        },
        {
            "block_label": "text",
            "block_content": "It is difficult for writers to identify their bad habits because they know their own writing too well. So have a reader help you identify yours:",
            "block_bbox": [
                128,
                351,
                783,
                397
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    128.0,
                    351.0
                ],
                [
                    783.0,
                    351.0
                ],
                [
                    783.0,
                    397.0
                ],
                [
                    128.0,
                    397.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Do you take too long to get to your subjects and verbs?",
            "block_bbox": [
                140,
                411,
                580,
                432
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
