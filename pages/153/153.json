                    140.0,
                    488.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Do you take too long to make your point (in sentences and in passages)?",
            "block_bbox": [
                140,
                495,
                705,
                517
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
