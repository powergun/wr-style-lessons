                ],
                [
                    772.0,
                    1008.0
                ],
                [
                    80.0,
                    1008.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Linguist Deborah Tannen suggests that “at the heart of the argument culture is our habit of seeing issues and ideas as absolute and irreconcilable principles continually at war,” and she challenges us to view them instead “as elements that coexist and should be brought into balance as much as possible” (284).",
            "block_bbox": [
                114,
                1019,
                742,
                1120
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
