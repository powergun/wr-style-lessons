        {
            "block_label": "text",
            "block_content": "Weaving a quotation into your own sentence works like a spotlight, focusing your readers' attention on particular words or phrases. The fewer words you quote, the tighter and brighter the beam. Compare:",
            "block_bbox": [
                80,
                930,
                772,
                1008
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
