        {
            "block_label": "text",
            "block_content": "Some inexperienced writers do begin too many sentences with and, but that is an error not in grammar but of style.",
            "block_bbox": [
                78,
                975,
                771,
                1024
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
