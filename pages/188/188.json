        },
        {
            "block_label": "number",
            "block_content": "177",
            "block_bbox": [
                736,
                69,
                770,
                88
            ],
            "block_id": 1,
            "block_order": null,
            "group_id": 1,
            "global_block_id": 1,
            "global_group_id": 1,
            "block_polygon_points": [
                [
