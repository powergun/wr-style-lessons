        {
            "block_label": "text",
            "block_content": "Many writers use the passive too often, but you will struggle to write clearly if you avoid it entirely. Use it in these contexts:",
            "block_bbox": [
                116,
                572,
                771,
                619
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    116.0,
                    572.0
                ],
                [
                    771.0,
                    572.0
                ],
                [
                    771.0,
                    619.0
                ],
                [
                    116.0,
                    619.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "You don't know who did an action, readers don't care, or you don't want them to know.",
            "block_bbox": [
                129,
                632,
                754,
                676
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
