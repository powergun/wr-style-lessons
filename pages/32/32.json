        {
            "block_label": "text",
            "block_content": "In 2016, the American Dialect Society named they used in this way as its “Word of the Year,” and it is now being recognized even by style guides that still balk at the use of they with indefinite referents, at least in formal contexts. Ultimately, it is less a matter of correctness or even style than of ethics, and we’ll consider it again in Lesson 11.",
            "block_bbox": [
                78,
                116,
                773,
                245
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
