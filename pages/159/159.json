                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "1. Weighty Words",
            "block_bbox": [
                92,
                678,
                287,
                706
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    92.0,
                    678.0
                ],
                [
                    287.0,
                    678.0
                ],
                [
                    287.0,
                    706.0
