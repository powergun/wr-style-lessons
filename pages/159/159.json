                [
                    105.0,
                    203.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "To finish, you have to wonder what else he might—or might not—have been.",
            "block_bbox": [
                91,
                217,
                746,
                243
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
