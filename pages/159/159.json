                    90.0,
                    870.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A study of intellectual differences among ethnicities is a project that only the most politically naive psychologist would be willing to give support to.",
            "block_bbox": [
                125,
                881,
                753,
                932
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
