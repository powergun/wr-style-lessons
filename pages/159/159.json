                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Here's the Point",
            "block_bbox": [
                130,
                305,
                365,
                337
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    130.0,
                    305.0
                ],
                [
                    365.0,
                    305.0
                ],
                [
                    365.0,
