        {
            "block_label": "text",
            "block_content": "In his earliest years, Picasso was not only a master draftsman of the traditional human form, but also...",
            "block_bbox": [
                105,
                154,
                752,
                203
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
