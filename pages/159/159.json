                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "How you begin a sentence determines its clarity; how you end it determines its rhythm and grace. Here are five ways to end a sentence with special emphasis.",
            "block_bbox": [
                90,
                607,
                784,
                660
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
