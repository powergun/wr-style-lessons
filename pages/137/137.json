            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Starting with Your Point",
            "block_bbox": [
                91,
                428,
                400,
                460
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
