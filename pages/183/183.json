        {
            "block_label": "paragraph_title",
            "block_content": "Lincoln's Second Inaugural Address",
            "block_bbox": [
                91,
                117,
                548,
                147
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
