                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Fellow citizens of the United States:",
            "block_bbox": [
                127,
                1098,
                418,
                1122
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
