            ]
        },
        {
            "block_label": "text",
            "block_content": "The first of those sentences is technically incorrect, at least in formal writing, but is the second unethical? It is easy to imagine it irritating some readers. Does the writer's allegiance to strict grammatical correctness override our golden rule of style?",
            "block_bbox": [
                79,
                967,
                772,
                1044
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    79.0,
                    967.0
                ],
                [
                    772.0,
                    967.0
                ],
                [
                    772.0,
                    1044.0
                ],
                [
                    79.0,
                    1044.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The sentences in that last example are general ones: addressed to no one in particular, they merely state a requirement that applies to all. But what about sentences that concern specific individuals who identify as non-binary? Here again is the example we used in Lesson 1:",
            "block_bbox": [
                78,
                1046,
                772,
                1148
            ],
            "block_id": 13,
            "block_order": 12,
