                [
                    91.0,
                    496.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "—ANTHONY BURGESS",
            "block_bbox": [
                332,
                503,
                520,
                524
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    332.0,
                    503.0
                ],
                [
                    519.0,
                    503.0
                ],
                [
                    519.0,
                    523.0
