                    164.0,
                    384.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "There is a satisfactory boniness about grammar which the flesh of sheer vocabulary requires before it can become vertebrate and walk the earth. But to study it for its own sake, without relating it to function, is utter madness.",
            "block_bbox": [
                91,
                412,
                760,
                496
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
