        {
            "block_label": "text",
            "block_content": "Grammar is the ground of all.\n—WILLIAM LANGLAND",
            "block_bbox": [
                307,
                243,
                542,
                298
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
