        {
            "block_label": "text",
            "block_content": "What follows is no tight theory of grammar, just useful definitions for the terms in this book. Where the text discusses something at length, we refer you to those pages. If you want a quick review to get started, read the entries on subject, simple subject, whole subject, and verb.",
            "block_bbox": [
                78,
                696,
                772,
                799
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
