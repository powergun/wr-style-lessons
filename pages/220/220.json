                [
                    332.0,
                    523.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Thou hast most traitorously corrupted the youth of the realm in erecting a grammar school.... It will be proved to thy face, that thou hast men about thee that usually talk of a noun and a verb, and such abominable words as no christian ear can endure to hear.",
            "block_bbox": [
                86,
                556,
                767,
                640
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "global_block_id": 5,
