        },
        {
            "block_label": "text",
            "block_content": "Most of the grounds of the world's troubles are matters of grammar.\n—MONTAIGNE",
            "block_bbox": [
                164,
                328,
                686,
                384
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
