        {
            "block_label": "text",
            "block_content": "analysis of the efforts of three universities to address aspirational recycling among students through informational emails and better labeling of recycling receptacles. We found that while emails had negligible impact on student behavior, marking receptacles with detailed graphics showing the types of materials that can be recycled reduced aspirational recycling by almost thirty-five percent. solution/point",
            "block_bbox": [
                126,
                116,
                754,
                267
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
