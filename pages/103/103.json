        {
            "block_label": "text",
            "block_content": "Some writers, especially student writers, believe the impact of their ideas depends on how forcefully they state them. But a strong main point, claim, or thesis alone will not make you persuasive. Readers will find your claims most meaningful if you present them as solutions to problems, practical or conceptual, that your readers care about.",
            "block_bbox": [
                127,
                415,
                784,
                511
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
