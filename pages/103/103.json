        {
            "block_label": "text",
            "block_content": "What best motivates readers is a problem in need of a solution, but a catchy opening can enliven your writing and vividly introduce your central themes. To name this device, we can use a musical term: prelude. Writers in the natural and social sciences rarely use preludes. They are more common in the humanities and most common in writing for the general public.",
            "block_bbox": [
                90,
                837,
                783,
                964
            ],
            "block_id": 9,
            "block_order": 8,
