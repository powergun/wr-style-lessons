        {
            "block_label": "text",
            "block_content": "When you read an academic book or article, look first for the implied question in its problem statement and then for its main claim, which answers that question. That will help focus your reading. If you don't find a question in the introduction, look for one in the conclusion. If that fails, find the main claim and ask yourself What question does this answer? The more you understand why a writer is telling you something, the better you will understand what she writes.",
            "block_bbox": [
                126,
                614,
                784,
                757
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
