        {
            "block_label": "text",
            "block_content": "Think of it this way: when you solve a practical problem, you change something in the world; when you solve a conceptual problem, you change someone's mind.",
            "block_bbox": [
                91,
                279,
                783,
                331
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
