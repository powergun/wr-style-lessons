                [
                    78.0,
                    498.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Some scientists, because they write in a style that is impersonal and abstract, do not easily communicate with laypeople.",
            "block_bbox": [
                112,
                513,
                742,
                563
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
