                [
                    112.0,
                    563.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "That because clause after the subject forces us to mentally hold our breath until we reach the verb, do... communicate. Move the interruption to the beginning or end of the sentence, depending on whether it connects more closely to what precedes or follows it (note the since instead of because).",
            "block_bbox": [
                78,
