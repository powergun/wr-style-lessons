        },
        {
            "block_label": "text",
            "block_content": "Avoid interrupting the subject-verb connection. You frustrate readers when you interrupt the connection between a subject and verb, like this:",
            "block_bbox": [
                78,
                446,
                772,
                498
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
