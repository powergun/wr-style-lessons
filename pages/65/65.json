                    90.0,
                    866.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3a.  $ \\underline{\\text{The centralization of functions by many retailers}} $ over the past several years has led to customer objections to more complicated purchasing procedures.",
            "block_bbox": [
                126,
                879,
                753,
                929
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
