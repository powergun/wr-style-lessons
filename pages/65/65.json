        {
            "block_label": "text",
            "block_content": "Did the nuns forgive the fellow who broke into their convent and assaulted them, or did they assault him after forgiving him? In other words, should we take assault as a noun or a verb? We can only tell from context. Scan the web to find other such examples of ambiguous “headlines.”",
            "block_bbox": [
                127,
                483,
                783,
                578
            ],
            "block_id": 8,
            "block_order": 7,
