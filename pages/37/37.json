            ]
        },
        {
            "block_label": "text",
            "block_content": "2a. Once upon a time, a walk through the woods was taking place on the part of Little Red Riding Hood, when the Wolf's jump out from behind a tree occurred, causing her fright.",
            "block_bbox": [
                126,
                213,
                756,
                288
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
