        {
            "block_label": "text",
            "block_content": "Now look at the verbs in 2a: was taking, occurred. Notice how vague they are. The characters' actions (pink) are expressed not in those verbs (boldfaced) but in abstract nouns:",
            "block_bbox": [
                91,
                152,
                784,
                203
            ],
            "block_id": 3,
            "block_order": 2,
