                [
                    126.0,
                    288.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The story isn't about taking place and occurring but about walking and jumping and frightening. In 2b, the verbs name these important story actions:",
            "block_bbox": [
                90,
