        {
            "block_label": "text",
            "block_content": "As we noted in Lesson 6, some writers think that if they reveal their main point in their introduction, readers will be bored and not read on. Not true. If you motivate readers with an interesting problem, they will want to see how you address it.",
            "block_bbox": [
                90,
                259,
                785,
                360
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
