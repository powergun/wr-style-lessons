        {
            "block_label": "text",
            "block_content": "For sections, your introductory opening segment might be a paragraph or more. For a whole document, you might need several paragraphs. Even in those cases, put your point sentence at the end of that opening segment, no matter how long it is. Again, be sure it's the last thing readers read before they begin the longer, more complex segment that follows.",
            "block_bbox": [
                124,
                117,
                784,
                247
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
