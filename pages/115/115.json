        },
        {
            "block_label": "paragraph_title",
            "block_content": "Here's the Point",
            "block_bbox": [
                129,
                412,
                364,
                442
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
