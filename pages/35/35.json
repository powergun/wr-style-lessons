        {
            "block_label": "text",
            "block_content": "Suit the action to the word, the word to the action.\n—WILLIAM SHAKESPEARE, HAMLET, 3.2",
            "block_bbox": [
                232,
                371,
                641,
                419
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "global_block_id": 1,
