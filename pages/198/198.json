            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Always separate an introductory element from the subject of a sentence with a comma if a reader might misunderstand the structure of the sentence, as in this one:",
            "block_bbox": [
                79,
                1146,
                772,
                1197
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
            "global_block_id": 15,
            "global_group_id": 15,
            "block_polygon_points": [
