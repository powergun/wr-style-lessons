                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Five Reliable Rules",
            "block_bbox": [
                80,
                1111,
                289,
                1137
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
