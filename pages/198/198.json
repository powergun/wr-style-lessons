        {
            "block_label": "text",
            "block_content": "fragments deliberately, as you just saw. Such fragments typically have two characteristics:",
            "block_bbox": [
                79,
                116,
                771,
                167
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
