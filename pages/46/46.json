                ],
                [
                    80.0,
                    697.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Your sentences are more concrete:",
            "block_bbox": [
                81,
                711,
                394,
                733
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
