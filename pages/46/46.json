                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Some Benefits of Making Actions Verbs",
            "block_bbox": [
                79,
                601,
                572,
                632
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
