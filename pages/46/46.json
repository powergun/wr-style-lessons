                [
                    79.0,
                    632.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When you consistently rely on verbs (boldfaced) to express important actions (pink), your readers benefit in many ways:",
            "block_bbox": [
                80,
                646,
                770,
                697
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
