        {
            "block_label": "text",
            "block_content": "When you revise a complicated sentence, you will likely have more than one character-action clause. Decide how the clauses fit together, then try out these patterns: X because Y; Since X, Y; If X, then Y; Although X, Y; X and/but/so Y.",
            "block_bbox": [
                117,
                484,
                770,
                555
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
