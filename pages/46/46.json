            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ The director decided to expand the program.",
            "block_bbox": [
                102,
                775,
                480,
                799
            ],
            "block_id": 16,
            "block_order": 15,
            "group_id": 16,
            "global_block_id": 16,
            "global_group_id": 16,
            "block_polygon_points": [
                [
