                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "There was a directorial decision for program expansion.",
            "block_bbox": [
                117,
                742,
                523,
                766
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
            "global_block_id": 15,
            "global_group_id": 15,
            "block_polygon_points": [
                [
