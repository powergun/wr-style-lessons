        {
            "block_label": "text",
            "block_content": "unpopular political views but also other forms of controversial expression, including artistic expression. Nevertheless, freedom of speech is not absolute: it is bounded by other rights and principles, including...",
            "block_bbox": [
                114,
                116,
                742,
                192
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
                    114.0,
