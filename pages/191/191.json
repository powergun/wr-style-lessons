                [
                    90.0,
                    941.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Sentences have traditionally been called simple, compound, and complex. If a sentence has just one independent clause (that is, just one clause that could stand alone as its own sentence), it is simple:",
            "block_bbox": [
                90,
                951,
                784,
                1029
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    90.0,
                    951.0
                ],
                [
                    784.0,
                    951.0
                ],
                [
                    784.0,
                    1029.0
                ],
                [
                    90.0,
                    1029.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The greatest English dictionary is the Oxford English Dictionary.",
            "block_bbox": [
                90,
                1040,
                611,
                1066
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "global_block_id": 6,
