                ],
                [
                    90.0,
                    867.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Simple, Compound, and Complex Sentences",
            "block_bbox": [
                90,
                907,
                651,
                941
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    90.0,
