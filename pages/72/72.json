        {
            "block_label": "text",
            "block_content": "These principles usually complement one another, but if you have to choose among them, favor these last two. The way you organize information in your sentences determines how cohesive readers will find your writing. And for readers, a passage's overall cohesion is more important than the clarity of individual sentences.",
            "block_bbox": [
                116,
                1008,
                770,
                1103
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
                    116.0,
