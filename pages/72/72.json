        {
            "block_label": "text",
            "block_content": "The word astronomers did not appear in the preceding sentences, but since we are reading about space, we wouldn't stumble if we were to find it beginning a sentence in the passage.",
            "block_bbox": [
                103,
                117,
                771,
                192
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
