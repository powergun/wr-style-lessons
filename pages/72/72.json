                    770.0,
                    1008.0
                ],
                [
                    770.0,
                    1103.0
                ],
                [
                    116.0,
                    1103.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We can integrate this old-before-new principle with our others. The general idea when crafting any sentence is to carry a reader from simplicity and familiarity to complexity and novelty.",
            "block_bbox": [
