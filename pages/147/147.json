                [
                    90.0,
                    341.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We should devote a few final words to a matter that reaches beyond the techniques of research to the connections between those subjective values that reflect our deepest ethical choices and objective research.",
            "block_bbox": [
                126,
                354,
                754,
                429
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
