        {
            "block_label": "text",
            "block_content": "This short-before-long principle aligns with our other principle of simple before complex. (It obviously takes fewer words to say something simple than to say something complex.) We introduced a version of it in Lesson 3, where we encouraged you to keep your subjects short. But it applies to phrases and clauses of all sorts, not just subjects. Sentences displaying well-formed coordination typically move from short phrases and clauses to longer ones. You can hear the effect if you read this next sentence aloud:",
            "block_bbox": [
                90,
                161,
                785,
                341
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
