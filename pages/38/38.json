        {
            "block_label": "text",
            "block_content": "In 2a, the sentence that seems wordy and indirect, the two main characters, Little Red Riding Hood and the Wolf, are not subjects, and their actions—walking, jumping, and frightening—are not verbs. In 2b, the more direct sentence, those two main characters are subjects and their main actions are verbs. That's why we prefer 2b.",
            "block_bbox": [
                114,
                715,
                772,
                811
            ],
            "block_id": 8,
            "block_order": 5,
            "group_id": 8,
