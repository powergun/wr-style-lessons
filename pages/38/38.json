        {
            "block_label": "text",
            "block_content": "Writing in college or on the job may seem distant from fairy tales like “Little Red Riding Hood.” But it’s not, because in every kind of writing, most sentences still tell stories. That is, they are still about characters doing things. Compare these two:",
            "block_bbox": [
                79,
                901,
                772,
                978
            ],
            "block_id": 10,
            "block_order": 7,
            "group_id": 10,
