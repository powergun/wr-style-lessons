        {
            "block_label": "text",
            "block_content": "2. In this particular section, I intend to discuss my position about the possible need to dispense with the standard approach to plea bargaining. I believe this for two reasons. The first reason is that there is the possibility of letting hardened criminals avoid receiving their just punishment. The second reason is the following: plea bargaining seems to encourage a growing lack of respect for the judicial system.",
            "block_bbox": [
                148,
                274,
                772,
                416
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
