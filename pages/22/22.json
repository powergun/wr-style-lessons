                ],
                [
                    501.0,
                    695.0
                ],
                [
                    501.0,
                    718.0
                ],
                [
                    94.0,
                    718.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ We all have that one rule which we will not give up.",
            "block_bbox": [
                94,
                736,
                520,
                760
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
