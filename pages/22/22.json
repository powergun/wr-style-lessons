                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ I can remember no less than five occasions when the correspondence columns of The Times rocked with volleys of letters...",
            "block_bbox": [
                90,
                859,
                743,
                907
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
                [
                    90.0,
