                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "\"Use fewer with nouns you count, less with nouns you cannot.\"",
            "block_bbox": [
                80,
                786,
                751,
                814
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
