                    90.0,
                    907.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "—Noel Gilroy Annan, Lord Annan, “The Life of the Mind in British Universities Today,” American Council of Learned Societies Newsletter",
            "block_bbox": [
                249,
                922,
                771,
                971
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
                    249.0,
                    922.0
                ],
                [
                    771.0,
                    922.0
                ],
                [
                    771.0,
                    971.0
                ],
                [
                    249.0,
                    971.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "No one uses fewer with mass nouns (fewer dirt) but educated writers often use less with countable plural nouns (less resources).",
            "block_bbox": [
                79,
                984,
                771,
                1035
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
            "global_block_id": 15,
            "global_group_id": 15,
            "block_polygon_points": [
                [
                    79.0,
                    984.0
                ],
                [
                    771.0,
                    984.0
                ],
                [
                    771.0,
                    1035.0
                ],
                [
                    79.0,
                    1035.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "“Use since and while to refer only to time, not to mean because or although.”",
            "block_bbox": [
                80,
                1061,
                763,
                1116
            ],
            "block_id": 16,
            "block_order": 15,
            "group_id": 16,
            "global_block_id": 16,
            "global_group_id": 16,
            "block_polygon_points": [
                [
                    80.0,
                    1061.0
                ],
                [
                    763.0,
                    1061.0
                ],
                [
                    763.0,
                    1116.0
                ],
                [
                    80.0,
                    1116.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Most careful writers use since with a meaning close to because but, as mentioned above, with an added sense of \"What follows I assume you already know\":",
            "block_bbox": [
                79,
                1124,
                772,
                1176
            ],
            "block_id": 17,
            "block_order": 16,
            "group_id": 17,
