                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Allegedly not this:",
            "block_bbox": [
                80,
                821,
                243,
                846
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
