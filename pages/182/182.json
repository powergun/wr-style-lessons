        {
            "block_label": "text",
            "block_content": "Style is the ultimate morality of mind.\n—ALFRED NORTH WHITEHEAD",
            "block_bbox": [
                268,
                370,
                581,
                418
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "global_block_id": 1,
            "global_group_id": 1,
            "block_polygon_points": [
