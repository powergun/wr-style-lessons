                ],
                [
                    420.0,
                    70.0
                ],
                [
                    420.0,
                    90.0
                ],
                [
                    164.0,
                    90.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "But that passive would have encouraged us to wonder  $ \\underline{\\text{by whom}} $? Instead, the writer found an active verb that moved the company off stage by suggesting that mistakes just occurred, seemingly on their own.",
            "block_bbox": [
                91,
                117,
                783,
                193
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
                    91.0,
                    117.0
                ],
                [
                    783.0,
                    117.0
                ],
                [
                    783.0,
                    193.0
                ],
                [
                    91.0,
                    193.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the second sentence, though, the writer used the first-person we to humanize the company, the responsible agent, and emphasize its good intentions:",
            "block_bbox": [
                90,
                195,
                783,
                246
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    90.0,
                    195.0
                ],
                [
                    783.0,
                    195.0
                ],
                [
                    783.0,
                    246.0
                ],
                [
                    90.0,
                    246.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "we...would never intentionally violate...",
            "block_bbox": [
                91,
                259,
                450,
                282
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    91.0,
                    259.0
                ],
                [
                    450.0,
                    259.0
                ],
                [
                    450.0,
                    282.0
                ],
                [
                    91.0,
                    282.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If we revise the first sentence to focus on the company and the second to hide it, we get a very different effect:",
            "block_bbox": [
                91,
                297,
                782,
                348
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    91.0,
                    297.0
                ],
                [
                    782.0,
                    297.0
                ],
                [
                    782.0,
                    348.0
                ],
                [
                    91.0,
                    348.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When we serviced over two million automotive customers last year in California, we made mistakes. However, you should know that no intentional violation of more than 100 years of trust occurred.",
            "block_bbox": [
                126,
                360,
                755,
                434
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    126.0,
                    360.0
                ],
                [
                    755.0,
                    360.0
                ],
                [
                    755.0,
                    434.0
                ],
                [
                    126.0,
                    434.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "That's a small point of stylistic manipulation, self-interested but innocent of any malign motives. This next one is more significant.",
            "block_bbox": [
                91,
                449,
                783,
                500
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    91.0,
                    449.0
                ],
                [
                    783.0,
                    449.0
                ],
                [
                    783.0,
                    500.0
                ],
                [
                    91.0,
                    500.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Who Pays? Consider this letter from a natural gas utility telling hundreds of thousands of customers that it was raising their rates. (The subject/topic in every clause, main or subordinate, is boldfaced.)",
            "block_bbox": [
                91,
                513,
                785,
                589
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    91.0,
                    513.0
                ],
                [
                    785.0,
                    513.0
                ],
                [
                    785.0,
                    589.0
                ],
                [
                    91.0,
                    589.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The State Utilities Commission has authorized a restructuring of our rates together with an increase in service charge revenues effective at the start of the next calendar year. This is the first increase in our rates in over six years. The restructuring of rates is consistent with revised state policy that rates for service to various classes of utility customers be based upon the cost of providing that service. The new rates move revenues from every class of customer closer to the cost actually incurred to provide gas service.",
            "block_bbox": [
                125,
                603,
                755,
                777
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    125.0,
                    603.0
                ],
                [
                    755.0,
                    603.0
                ],
                [
                    755.0,
                    777.0
                ],
                [
                    125.0,
                    777.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "That notice is a model of misdirection: after the first sentence, the writer never again begins a sentence with a human character, least of all the character whose interests are most at stake—the reader. The reader is mentioned only twice, in the third person, and never as a subject/topic/agent:",
            "block_bbox": [
                90,
                791,
                785,
                894
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    90.0,
                    791.0
                ],
                [
                    785.0,
                    791.0
                ],
                [
                    785.0,
                    894.0
                ],
                [
                    90.0,
                    894.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "...for service to various classes of utility customers",
            "block_bbox": [
                129,
                907,
                523,
                930
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    129.0,
                    907.0
                ],
                [
                    523.0,
                    907.0
                ],
                [
                    523.0,
                    930.0
                ],
                [
                    129.0,
                    930.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "...move revenues from every class of customer",
            "block_bbox": [
                129,
                932,
                496,
                955
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    129.0,
                    932.0
                ],
                [
                    496.0,
                    932.0
                ],
                [
                    496.0,
                    955.0
                ],
                [
                    129.0,
                    955.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The anonymous writer of that notice refers to the gas company only twice, in the phrase our rates, and never identifies the company as a responsible subject/topic/agent. Had the company wanted to make clear who the real \"doer\" was and who was being done to, the notice would have read more like this:",
            "block_bbox": [
                90,
                973,
                784,
                1076
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
                [
                    90.0,
                    973.0
                ],
                [
                    784.0,
                    973.0
                ],
                [
                    784.0,
                    1076.0
                ],
                [
                    90.0,
                    1076.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "According to the State Utilities Commission, we can now make you pay more for your gas service after the new year. We have not made you pay more in over six years, but under revised state policy, now we can.",
            "block_bbox": [
                126,
                1089,
                754,
                1163
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
                    126.0,
                    1089.0
                ],
                [
                    754.0,
                    1089.0
                ],
                [
                    754.0,
                    1163.0
                ],
                [
                    126.0,
                    1163.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We can reasonably charge those writers with breaching the golden rule of style: the deflection of responsibility seems deliberate, and they surely would not want that same kind of writing directed to them in a matter of personal interest.",
            "block_bbox": [
                91,
                1176,
                784,
                1253
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
            "global_block_id": 15,
            "global_group_id": 15,
            "block_polygon_points": [
