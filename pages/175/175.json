        {
            "block_label": "header",
            "block_content": "Style: Lessons in Clarity and Grace",
            "block_bbox": [
                164,
                70,
                421,
                91
            ],
            "block_id": 1,
            "block_order": null,
            "group_id": 1,
            "global_block_id": 1,
            "global_group_id": 1,
            "block_polygon_points": [
                [
                    164.0,
