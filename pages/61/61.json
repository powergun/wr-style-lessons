        {
            "block_label": "text",
            "block_content": "Based on the writers' verbal intelligence, prior knowledge, and essay scores, I analyzed their essays for structure and evaluated them for richness of concepts. I then separated the subjects into high- and low-ability groups. I randomly assigned half of each group to a treatment group or to a placebo group.",
            "block_bbox": [
                126,
                654,
                755,
                756
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
