                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Some scholarly writers use the passive voice to avoid first-person subjects (I and we) and create an objective point of view:",
            "block_bbox": [
                91,
                439,
                782,
                490
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
