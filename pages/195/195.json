        {
            "block_label": "text",
            "block_content": "Some readers have reservations about these next four ways of signaling the end of a grammatical sentence, but careful writers regularly use them.",
            "block_bbox": [
                91,
                346,
                784,
                397
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
