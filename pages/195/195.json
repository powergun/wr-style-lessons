                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This technique, which adds a touch of informality, can lighten up a passage that feels too somber. In serious contexts, use it no more than once or twice a page, especially with and.",
            "block_bbox": [
                108,
                576,
                783,
                651
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
