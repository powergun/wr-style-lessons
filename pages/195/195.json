        {
            "block_label": "text",
            "block_content": "4. Period + Coordinating Conjunction Some think that it's wrong to begin a punctuated sentence with a coordinating conjunction such as and or but (review p. 9). But they are wrong. The second sentence here is entirely correct:",
            "block_bbox": [
                92,
                409,
                784,
                511
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
