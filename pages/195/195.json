            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ Education cannot guarantee freedom. And when it is available to only a few, it becomes a tool of social repression.",
            "block_bbox": [
                96,
                521,
                755,
                569
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
