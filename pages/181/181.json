                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The golden rule of style is to write to others as you would have them write to you. It asks you to put yourself in your readers' shoes. Recall an occasion when you violated this principle or were tempted to. What was the situation? What did you do? Was the violation justified? Would you do anything differently now? The silver rule of style is to not write to others as you would not have them write to you. It asks you to be fair. Recall an occasion when you violated this principle or were tempted to. What was the situation? What did you do? Would you do anything differently now?",
            "block_bbox": [
                126,
                185,
                785,
                352
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
