        },
        {
            "block_label": "paragraph_title",
            "block_content": "Exercise 11.4",
            "block_bbox": [
                130,
                378,
                326,
                408
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
