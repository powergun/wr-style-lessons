                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We confront ethical issues in writing every day. For one week, pay attention to the writing you encounter in your everyday life: labels on products, the fine print on bills, bulk mail advertisements, spam in your email account, and so on. Select three examples that raise ethical issues you would like to talk about, and share them with a colleague or with your class. What ethical issues do they raise? Why do you imagine their writers wrote them as they did? How would those examples need to be revised to make them ethical?",
            "block_bbox": [
                127,
                423,
                784,
                591
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    127.0,
                    423.0
                ],
                [
                    784.0,
                    423.0
                ],
                [
                    784.0,
