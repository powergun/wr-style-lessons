        {
            "block_label": "paragraph_title",
            "block_content": "Exercise 11.3 In Your Own Words",
            "block_bbox": [
                130,
                139,
                614,
                169
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
