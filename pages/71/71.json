            ]
        },
        {
            "block_label": "text",
            "block_content": "If, however, we follow sentence 1 with 2b, the one with the passive verb, we feel those sentences connect more smoothly. That's because the first words in 2b repeat what we just read at the end of 1:",
            "block_bbox": [
                90,
                269,
                783,
                346
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
