                    784.0,
                    761.0
                ],
                [
                    127.0,
                    761.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Managing Information: Old Before New",
            "block_bbox": [
                91,
                850,
                525,
                879
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    91.0,
                    850.0
                ],
                [
                    525.0,
                    850.0
                ],
                [
                    525.0,
                    879.0
