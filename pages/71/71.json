        {
            "block_label": "text",
            "block_content": "Sentences are cohesive when the last few words of one sentence set up information that appears in the first few words of the next. That's what gives us our experience of flow. In fact, that's an important function of the passive voice: to let us arrange sentences so that they flow easily from one to the next.",
            "block_bbox": [
                127,
                665,
                784,
                761
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
