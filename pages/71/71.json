        {
            "block_label": "text",
            "block_content": " $ ^{1} $Some astonishing questions about the nature of the universe have been raised by scientists studying  $ \\underline{\\text{black holes in space.}} $  $ ^{2a} $The collapse of a dead star into a point perhaps no larger than a marble creates...",
            "block_bbox": [
                118,
                179,
                754,
                255
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
