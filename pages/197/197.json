        {
            "block_label": "text",
            "block_content": "Avoid a colon if it breaks a clause into two pieces, neither of which is a grammatically complete sentence. Avoid this:",
            "block_bbox": [
                127,
                438,
                782,
                485
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
