        {
            "block_label": "text",
            "block_content": "1. Critics cannot avoid employing complex and abstract technical terms if they are to successfully analyze literary texts and discuss them in a meaningful way.",
            "block_bbox": [
                150,
                226,
                771,
                295
            ],
            "block_id": 4,
            "block_order": 3,
