                ],
                [
                    555.0,
                    308.0
                ],
                [
                    117.0,
                    308.0
                ]
            ]
        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td></td><td>subject</td><td>verb</td><td>object</td></tr><tr><td>Active:</td><td>I</td><td>lost</td><td>the money.</td></tr><tr><td></td><td>character/agent/source</td><td>action</td><td>goal</td></tr></table>",
            "block_bbox": [
                140,
                334,
                740,
                422
            ],
            "block_id": 7,
            "block_order": null,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
