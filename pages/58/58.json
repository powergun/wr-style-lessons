                ]
            ]
        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td rowspan=\"3\">Passive:</td><td>subject</td><td>be + verb</td><td>prepositional phrase</td></tr><tr><td>The money</td><td>was lost</td><td>[by me].</td></tr><tr><td>goal</td><td>action</td><td>character/agent/source</td></tr></table>",
            "block_bbox": [
                135,
                639,
                764,
                726
            ],
            "block_id": 11,
            "block_order": null,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
