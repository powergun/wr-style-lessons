                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A verb is in the passive voice when its past participle is preceded by a form of be (as it is in this next example). The passive differs from the active in two ways:",
            "block_bbox": [
                78,
                441,
                773,
                517
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    78.0,
                    441.0
                ],
                [
                    773.0,
                    441.0
                ],
                [
                    773.0,
                    517.0
                ],
                [
                    78.0,
                    517.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- The subject names the goal or receiver of the action.",
            "block_bbox": [
                116,
                531,
                576,
                554
            ],
            "block_id": 9,
            "block_order": 7,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    116.0,
                    531.0
                ],
                [
                    576.0,
                    531.0
                ],
                [
                    576.0,
                    554.0
                ],
                [
                    116.0,
                    554.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- The character, agent, or source of the action comes after the verb in a by-phrase or is dropped entirely:",
            "block_bbox": [
                117,
                563,
                772,
                614
            ],
            "block_id": 10,
            "block_order": 8,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
