        },
        {
            "block_label": "text",
            "block_content": "More than any other advice, you probably remember Write in the active voice, not the passive. That's not bad advice, but it has exceptions.",
            "block_bbox": [
                80,
                161,
                770,
                210
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    80.0,
                    161.0
                ],
                [
                    770.0,
                    161.0
                ],
                [
                    770.0,
                    210.0
                ],
                [
                    80.0,
                    210.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When you write in the active voice, you typically put",
            "block_bbox": [
                116,
                213,
                571,
                237
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    116.0,
                    213.0
                ],
                [
                    571.0,
                    213.0
                ],
                [
                    571.0,
                    237.0
                ],
                [
                    116.0,
                    237.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• the character, agent, or source of an action in the subject",
            "block_bbox": [
                117,
                251,
                612,
                275
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    117.0,
                    251.0
                ],
                [
                    612.0,
                    251.0
                ],
                [
                    612.0,
                    275.0
                ],
                [
                    117.0,
                    275.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• the goal or receiver of an action in a direct object:",
            "block_bbox": [
                117,
                283,
                555,
                308
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    117.0,
