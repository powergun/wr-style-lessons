        {
            "block_label": "text",
            "block_content": "If you have managed your subjects and topics well, you will naturally put the words you want to emphasize toward the ends of your sentences. To test this, read your sentence aloud and, as you reach the last three or four words, tap your finger hard as if emphasizing them in a speech. If you tap on words that do not deserve strong emphasis, look for words that do. Then put those words closer to the end. Here are some ways to do that.",
            "block_bbox": [
                78,
                376,
                773,
                531
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
