        {
            "block_label": "text",
            "block_content": "It is not true that academic writers always avoid the first person. But they do tend to use it in certain places and in certain ways. Most commonly, the first person appears in what is called metadiscourse.",
            "block_bbox": [
                78,
                591,
                772,
                669
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
