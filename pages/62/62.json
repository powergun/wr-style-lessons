                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Metadiscourse",
            "block_bbox": [
                80,
                695,
                268,
                723
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
