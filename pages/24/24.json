                    78.0,
                    268.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "\"Use whom as the object of a verb or preposition.\"",
            "block_bbox": [
                80,
                292,
                612,
                321
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
