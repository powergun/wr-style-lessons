                [
                    80.0,
                    321.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This was once a real rule, but since whom is disappearing from the language, it is now an elegant option. Purists would condemn William Zinsser for this use of who:",
            "block_bbox": [
                79,
                329,
                772,
                404
            ],
            "block_id": 6,
            "block_order": 5,
