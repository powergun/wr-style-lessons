        {
            "block_label": "text",
            "block_content": "The first is correct; the second is more formal. (Again, see the Ong passage on p. 9.) Some conservatives apply this rule not only to sentences but to every clause.",
            "block_bbox": [
                78,
                192,
                772,
                268
            ],
            "block_id": 4,
            "block_order": 3,
