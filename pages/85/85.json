                    90.0,
                    241.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "How you manage this stress position helps establish the voice readers hear in your writing. If you end a sentence with words that carry little meaning, it will seem to finish weakly:",
            "block_bbox": [
                90,
                245,
                784,
                321
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
