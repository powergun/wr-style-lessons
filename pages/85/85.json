        {
            "block_label": "text",
            "block_content": "Compare these passages. The original laments the way universities in the 1990s responded to a decline in the number of potential students—by becoming increasingly commercial:",
            "block_bbox": [
                91,
                592,
                785,
                669
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    91.0,
