        },
        {
            "block_label": "text",
            "block_content": "We'll call this most emphatic part of a sentence its stress.",
            "block_bbox": [
                90,
                219,
                569,
                241
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
