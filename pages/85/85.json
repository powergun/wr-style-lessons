        {
            "block_label": "text",
            "block_content": "If we move those references to businesses, customers, buyers, and brands out of the sentences' ends, we blunt the passage's edge:",
            "block_bbox": [
                91,
                832,
                784,
                882
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
