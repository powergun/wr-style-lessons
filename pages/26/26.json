                [
                    79.0,
                    204.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "☑ We the People of the United States, in order to form a more perfect union...",
            "block_bbox": [
                78,
                217,
                714,
                241
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    78.0,
                    217.0
                ],
                [
                    714.0,
                    217.0
                ],
                [
                    714.0,
                    241.0
                ],
                [
                    78.0,
                    241.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Even so, this rule is generally worth following.",
            "block_bbox": [
                79,
                255,
                479,
                281
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    79.0,
                    255.0
                ],
                [
                    479.0,
                    255.0
                ],
                [
                    479.0,
                    281.0
                ],
                [
                    79.0,
                    281.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "\"Never ever use irregardless for regardless or irrespective.\"",
            "block_bbox": [
                80,
                299,
                681,
                328
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    80.0,
                    299.0
                ],
                [
                    681.0,
                    299.0
                ],
                [
                    681.0,
                    328.0
                ],
                [
                    80.0,
                    328.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "However arbitrary this rule is, follow it. Use irregardless and some will judge you irredeemable.",
            "block_bbox": [
                79,
                335,
                772,
                386
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    79.0,
