                [
                    772.0,
                    335.0
                ],
                [
                    772.0,
                    386.0
                ],
                [
                    79.0,
                    386.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Some Words that Attract Special Attention",
            "block_bbox": [
                78,
                408,
                610,
                438
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    78.0,
                    408.0
                ],
                [
                    610.0,
                    408.0
                ],
                [
                    610.0,
                    438.0
                ],
                [
                    78.0,
                    438.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Some words are so often confused with others that careful readers are likely to note when you correctly distinguish them. Here are some:",
            "block_bbox": [
                79,
                452,
                771,
                503
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    79.0,
                    452.0
                ],
                [
                    771.0,
                    452.0
                ],
                [
                    771.0,
                    503.0
                ],
                [
                    79.0,
                    503.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "aggravate means to make worse. Fastidious readers may object if you use it to mean annoy.",
            "block_bbox": [
                114,
                515,
                771,
                539
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    114.0,
                    515.0
                ],
                [
                    771.0,
                    515.0
                ],
                [
                    771.0,
                    539.0
                ],
                [
                    114.0,
                    539.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "anticipate means to prepare for a contingency. It does not mean just expect. You anticipate a question when you prepare its answer before it's asked; if you know it's coming but don't prepare, you only expect it.",
            "block_bbox": [
                114,
                544,
                771,
                616
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    114.0,
                    544.0
                ],
                [
                    771.0,
                    544.0
                ],
                [
                    771.0,
                    616.0
                ],
                [
                    114.0,
                    616.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "anxious means uneasy not eager. You're eager to leave if you're happy to go. You're anxious about leaving if it makes you nervous.",
            "block_bbox": [
                115,
                622,
                771,
                670
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    115.0,
                    622.0
                ],
                [
                    771.0,
                    622.0
                ],
                [
                    771.0,
                    670.0
                ],
                [
                    115.0,
                    670.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "blackmail means to extort by threatening to reveal damaging information. It does not mean simply coerce. One country cannot blackmail another with nuclear weapons when it only threatens to use them.",
            "block_bbox": [
                115,
                677,
                772,
                747
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
                [
                    115.0,
                    677.0
                ],
                [
                    772.0,
                    677.0
                ],
                [
                    772.0,
                    747.0
                ],
                [
                    115.0,
                    747.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "comprise means to include all parts in a single unit. It is not synonymous with compose or constitute. The alphabet is not comprised by its letters; it comprises them. Letters constitute the alphabet, which is thus constituted by them.",
            "block_bbox": [
                115,
                755,
                772,
                826
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
                    115.0,
                    755.0
                ],
                [
                    772.0,
                    755.0
                ],
                [
                    772.0,
                    826.0
                ],
                [
                    115.0,
                    826.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "continuous means without interruption. It is not synonymous with continual, which means an activity continued through time, with interruptions. If you continuously interrupt someone, that person will never say a word because your interruption will never stop. If you continually interrupt, you let the other person finish a sentence from time to time.",
            "block_bbox": [
                115,
                833,
                772,
                951
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
            "global_block_id": 15,
            "global_group_id": 15,
            "block_polygon_points": [
                [
                    115.0,
                    833.0
                ],
                [
                    772.0,
                    833.0
                ],
                [
                    772.0,
                    951.0
                ],
                [
                    115.0,
                    951.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "disinterested means neutral. It does not mean uninterested. A judge should be disinterested in the outcome of a case but not uninterested in it. (Incidentally, the original meaning of disinterested was to be uninterested.)",
            "block_bbox": [
                116,
                959,
                771,
                1030
            ],
            "block_id": 16,
            "block_order": 15,
            "group_id": 16,
            "global_block_id": 16,
            "global_group_id": 16,
            "block_polygon_points": [
                [
                    116.0,
                    959.0
                ],
                [
                    771.0,
                    959.0
                ],
                [
                    771.0,
                    1030.0
                ],
                [
                    116.0,
                    1030.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "enormity means a horrible wrong. It does not mean enormousness. In private, a belch might be enormous, but at a state funeral, it would also be an enormity.",
            "block_bbox": [
                116,
                1037,
                771,
                1084
            ],
            "block_id": 17,
            "block_order": 16,
            "group_id": 17,
            "global_block_id": 17,
            "global_group_id": 17,
            "block_polygon_points": [
                [
                    116.0,
                    1037.0
                ],
                [
                    771.0,
                    1037.0
                ],
                [
                    771.0,
                    1084.0
                ],
                [
                    116.0,
                    1084.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "flaunt means to display conspicuously. It is not synonymous with flout, which means to scorn a rule or standard. If you choose to scorn this distinction, you would not flout your flaunting it but flaunt your flouting it.",
            "block_bbox": [
                114,
                1091,
                772,
                1162
            ],
            "block_id": 18,
            "block_order": 17,
            "group_id": 18,
            "global_block_id": 18,
            "global_group_id": 18,
            "block_polygon_points": [
                [
                    114.0,
                    1091.0
                ],
                [
                    772.0,
                    1091.0
                ],
                [
                    772.0,
                    1162.0
                ],
                [
                    114.0,
                    1162.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "fortuitous means by chance. It does not mean fortunate. You are fortunate when you fortuitously pick the right number in the lottery.",
            "block_bbox": [
                113,
                1169,
                772,
                1215
            ],
            "block_id": 19,
            "block_order": 18,
            "group_id": 19,
