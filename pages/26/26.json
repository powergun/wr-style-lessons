        {
            "block_label": "text",
            "block_content": "\"Don't modify absolute words such as perfect, unique, final, or complete with very, more, quite, and so on.\"",
            "block_bbox": [
                80,
                116,
                734,
                173
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
                    80.0,
                    116.0
                ],
                [
                    734.0,
                    116.0
                ],
