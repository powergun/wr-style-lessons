                    734.0,
                    173.0
                ],
                [
                    80.0,
                    173.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "That rule would have deprived us of this familiar sentence:",
            "block_bbox": [
                79,
                179,
                585,
                204
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
