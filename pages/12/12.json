                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "The Causes of Unclear Writing",
            "block_bbox": [
                79,
                931,
                466,
                962
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    79.0,
                    931.0
                ],
                [
                    466.0,
                    931.0
                ],
                [
                    466.0,
