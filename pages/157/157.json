        {
            "block_label": "text",
            "block_content": "- The verb charmed echoes and amplifies the earlier cheered, with which it alliterates (or shares consonant sounds).",
            "block_bbox": [
                130,
                492,
                783,
                541
            ],
            "block_id": 5,
            "block_order": 3,
