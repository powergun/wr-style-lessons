                    130.0,
                    763.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- This prepositional phrase not only contrasts the city's violence with the team's play and sportsmanship but elegantly extends the line of the sentence with its compound object, itself composed of two alliterative and coordinate noun phrases. (To experience this effect, try swapping the verb phrases so the sentence reads \"not only charmed...but cheered...\" and hear the difference.)",
            "block_bbox": [
                128,
                771,
                784,
                923
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
