                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- The second direct object country contrasts with the first, city, an effect enhanced by the different articles that introduce these words.",
            "block_bbox": [
                130,
                550,
                782,
                599
            ],
            "block_id": 6,
            "block_order": 4,
            "group_id": 6,
            "global_block_id": 6,
