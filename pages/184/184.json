                [
                    80.0,
                    332.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Now we are engaged in a great civil war, testing whether that nation, or any nation so conceived and so dedicated, can long endure. We are met on a great battle-field of that war. We have come to dedicate a portion of that field...",
            "block_bbox": [
                113,
                348,
                743,
                421
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    113.0,
                    348.0
                ],
                [
                    743.0,
                    348.0
                ],
                [
                    743.0,
                    421.0
                ],
                [
                    113.0,
                    421.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "So we must ask: Why would an accomplished stylist like Lincoln, a stylist known for his honesty, clarity, and directness, choose to begin his address with such an abstract and indirect style?",
            "block_bbox": [
                79,
                437,
                772,
                512
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
