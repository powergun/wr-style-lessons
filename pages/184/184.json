        {
            "block_label": "text",
            "block_content": "As we meet for this second taking of the oath of the presidential office, we have less need for an extended address than we had at the first. Then we felt a statement, describing in detail, the course we would pursue would be fitting and proper...",
            "block_bbox": [
                113,
                194,
                742,
                293
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
