                    113.0,
                    293.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "And that is close to the Gettysburg Address:",
            "block_bbox": [
                80,
                308,
                458,
                332
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
