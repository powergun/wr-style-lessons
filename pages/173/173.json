                    89.0,
                    374.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We'll look at several examples to explore these sorts of ethical issues, including in Lesson 12 one of the most celebrated speeches in American history, Abraham Lincoln's Second Inaugural Address.",
            "block_bbox": [
                90,
                377,
                783,
                453
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
