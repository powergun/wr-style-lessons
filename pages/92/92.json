        },
        {
            "block_label": "text",
            "block_content": "We depend on concepts running through a passage to create a sense of its coherence. You help readers identify those concepts in two ways:",
            "block_bbox": [
                115,
                185,
                769,
                232
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    115.0,
                    185.0
                ],
                [
                    769.0,
                    185.0
                ],
                [
                    769.0,
                    232.0
                ],
                [
                    115.0,
                    232.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Repeat those that name characters as topics of sentences, usually as subjects.",
            "block_bbox": [
                128,
                245,
                736,
                266
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    128.0,
