                ],
                [
                    128.0,
                    266.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Repeat others as themes elsewhere in a passage, in nouns, verbs, and adjectives.",
            "block_bbox": [
                128,
                269,
                758,
                291
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    128.0,
                    269.0
                ],
                [
                    758.0,
                    269.0
                ],
                [
                    758.0,
                    291.0
                ],
                [
                    128.0,
                    291.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Readers are more likely to notice those themes if you emphasize them at the end of the sentence that introduces the passage.",
            "block_bbox": [
                118,
                306,
                770,
                352
            ],
            "block_id": 6,
