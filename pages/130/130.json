            ]
        },
        {
            "block_label": "text",
            "block_content": "Even confident scientists hedge. This next paragraph introduced the most significant breakthrough in the history of genetics, the discovery of the double helix of DNA. If anyone was entitled to be assertive, it was Crick and Watson. But they chose to be diffident (note, too, the first person we; hedges are boldfaced):",
            "block_bbox": [
                78,
                962,
                773,
                1065
            ],
            "block_id": 17,
            "block_order": 16,
            "group_id": 17,
            "global_block_id": 17,
            "global_group_id": 17,
            "block_polygon_points": [
                [
                    78.0,
                    962.0
                ],
                [
                    773.0,
                    962.0
                ],
                [
                    773.0,
                    1065.0
                ],
                [
                    78.0,
                    1065.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We wish to suggest a [not the] structure for the salt of deoxyribose nucleic acid (D.N.A.)... A structure for nucleic acid has already been proposed by Pauling and Corey... In our opinion, this structure is unsatisfactory for two reasons: (1) We believe that the material which gives the X-ray diagrams is the salt, not the free acid... (2) Some of the van der Waals distances appear to be too small.",
            "block_bbox": [
                114,
                1077,
                743,
                1201
            ],
            "block_id": 18,
            "block_order": 17,
            "group_id": 18,
