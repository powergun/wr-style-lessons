                [
                    88.0,
                    798.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The verbs indicate and suggest let you state a claim about which you are less than 100 percent certain but confident enough to propose:",
            "block_bbox": [
                79,
                814,
                772,
                864
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
