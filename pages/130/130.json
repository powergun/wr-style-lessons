            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ These data suggest that further studies are necessary.",
            "block_bbox": [
                92,
                921,
                532,
                944
            ],
            "block_id": 16,
            "block_order": 15,
            "group_id": 16,
