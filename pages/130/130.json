                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Too much hedging sounds mealy-mouthed, like this:",
            "block_bbox": [
                80,
                411,
                530,
                436
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    80.0,
                    411.0
                ],
                [
                    530.0,
                    411.0
                ],
                [
                    530.0,
                    436.0
                ],
                [
                    80.0,
                    436.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "There seems to be some evidence to suggest that certain differences between Japanese and Western rhetoric could derive from historical influences possibly traceable to what might be called Japan's cultural isolation and Europe's history of cross-cultural contacts.",
            "block_bbox": [
                113,
                447,
                743,
                546
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    113.0,
                    447.0
                ],
                [
                    743.0,
                    447.0
                ],
                [
                    743.0,
                    546.0
                ],
                [
                    113.0,
                    546.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "On the other hand, only a fool or someone with massive historical evidence would make an assertion as flatly certain as this:",
            "block_bbox": [
                78,
                560,
                772,
                609
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    78.0,
                    560.0
                ],
                [
                    772.0,
                    560.0
                ],
                [
                    772.0,
                    609.0
                ],
                [
                    78.0,
                    609.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This evidence proves that Japanese and Western rhetorics differ because of Japan's cultural isolation and Europe's history of cross-cultural contacts.",
            "block_bbox": [
                109,
                621,
                744,
                670
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    109.0,
                    621.0
                ],
                [
                    744.0,
                    621.0
                ],
                [
                    744.0,
                    670.0
                ],
                [
                    109.0,
                    670.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In most academic writing, we more often state claims closer to this (note our own hedging):",
            "block_bbox": [
                79,
                684,
                772,
                735
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    79.0,
                    684.0
                ],
                [
                    772.0,
                    684.0
                ],
                [
                    772.0,
                    735.0
                ],
                [
                    79.0,
                    735.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ This evidence suggests that aspects of Japanese and Western rhetoric differ because of Japan's relative cultural isolation and Europe's history of cross-cultural contacts.",
            "block_bbox": [
                88,
                749,
                742,
                798
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
                [
                    88.0,
                    749.0
                ],
                [
                    742.0,
                    749.0
                ],
                [
                    742.0,
