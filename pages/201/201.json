        },
        {
            "block_label": "text",
            "block_content": "Choose a dash or a colon depending on how formal you want to seem. A dash is less formal.",
            "block_bbox": [
                90,
                117,
                783,
                166
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
