                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Using Sources Properly",
            "block_bbox": [
                79,
                814,
                377,
                847
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
