        {
            "block_label": "text",
            "block_content": "Read over your compositions, and wherever you meet with a passage which you think is particularly fine, strike it out.\n—SAMUEL JOHNSON",
            "block_bbox": [
                147,
                370,
                703,
                442
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
