        },
        {
            "block_label": "text",
            "block_content": "What most makes a sentence graceful is a balance or symmetry among its parts, one echoing another in sound, rhythm, structure, and meaning. A skilled writer can balance almost any parts of a sentence, but the most common balance is based on coordination.",
            "block_bbox": [
                79,
                851,
                772,
                951
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
