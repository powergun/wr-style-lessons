        {
            "block_label": "text",
            "block_content": "The qualities of elegance are too varied and subtle to capture in a summary. Nevertheless, elegant passages typically have three characteristics that may seem incompatible but are not:",
            "block_bbox": [
                79,
                824,
                771,
                900
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    79.0,
