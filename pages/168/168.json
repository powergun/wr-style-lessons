                    129.0,
                    409.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Life as a college student offers a few years of intellectual excitement but imposes a sense of anxiety on those who look ahead and know that it is in sight.",
            "block_bbox": [
                129,
