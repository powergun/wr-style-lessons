                    771.0,
                    900.0
                ],
                [
                    79.0,
                    900.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. the simplicity of characters as subjects and actions as verbs",
            "block_bbox": [
                79,
                913,
                606,
                937
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
