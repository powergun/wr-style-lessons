        {
            "block_label": "text",
            "block_content": "The most exact sequences they reconstructed were several lines of pigs that had been common at the site and had developed rapidly. The team produced family trees that dated types of pigs so accurately that when they found pigs next to fossils of questionable age, they could use the pigs to date the fossils.",
            "block_bbox": [
                114,
                116,
                743,
                217
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
                    114.0,
                    116.0
                ],
                [
                    743.0,
                    116.0
                ],
                [
                    743.0,
                    217.0
                ],
