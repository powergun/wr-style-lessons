                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A sentence’s topic does not have to be its grammatical subject, although in clear and coherent writing it often is. Topic is not a grammatical term but a psychological one: it refers to the idea that readers expect the sentence to be “about” or “comment on.” Readers expect to find this idea stated toward the beginning of the sentence, often but not always as the grammatical subject.",
            "block_bbox": [
                90,
                828,
                784,
                955
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
                    90.0,
                    828.0
                ],
                [
                    784.0,
                    828.0
                ],
                [
                    784.0,
                    955.0
                ],
                [
                    90.0,
                    955.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Readers consider a passage coherent to the degree that they can quickly and easily see two things:",
            "block_bbox": [
                92,
                958,
                784,
                1008
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
