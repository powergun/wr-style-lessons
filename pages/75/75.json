                    783.0,
                    321.0
                ],
                [
                    90.0,
                    321.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "For example, none of the grammatical subjects (italicized) in these sentences name their topics (bold).",
            "block_bbox": [
                91,
                326,
                783,
                375
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
