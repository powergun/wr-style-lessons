                [
                    91.0,
                    375.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- The grammatical subject of this sentence is it, but its topic is your claim, the object of the preposition for:",
            "block_bbox": [
                129,
                391,
                782,
                441
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
