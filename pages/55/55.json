        },
        {
            "block_label": "text",
            "block_content": "The way to make an abstraction into a character is to make it the subject of a series of sentences and clauses. (We'll talk more about this issue in Lesson 4 when we discuss topics.) Here's a story about freedom of speech (gold), a familiar abstraction made up of two nominalizations (whole subjects are underlined):",
            "block_bbox": [
                91,
                1004,
                785,
                1106
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
