        {
            "block_label": "text",
            "block_content": "Our first principle is this: a sentence seems clear when its important actions are in verbs. Look at how sentences 4a and 4b express their actions. In 4a, most of the actions (pink) are not verbs (boldfaced) but nouns:",
            "block_bbox": [
                79,
                564,
                772,
                640
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
