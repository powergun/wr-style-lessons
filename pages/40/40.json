                ],
                [
                    772.0,
                    640.0
                ],
                [
                    79.0,
                    640.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4a. Our lack of data prevented evaluation of UN actions in targeting funds to areas most in need of assistance.",
            "block_bbox": [
                113,
                652,
                741,
                701
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
