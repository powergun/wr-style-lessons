        {
            "block_label": "text",
            "block_content": "✓ In 1967 Congress passed civil rights laws that remedied problems of registration and voting; those laws had political consequences throughout the South.",
            "block_bbox": [
                91,
                206,
                742,
                256
            ],
            "block_id": 3,
            "block_order": 2,
