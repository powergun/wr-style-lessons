            ]
        },
        {
            "block_label": "text",
            "block_content": "Many writers avoid semicolons because they find them mildly intimidating. So learning their use might be worth your time, especially if you want to be judged a sophisticated writer. Once every couple of pages is probably about right.",
            "block_bbox": [
                103,
                268,
                772,
                344
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
