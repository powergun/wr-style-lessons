        },
        {
            "block_label": "text",
            "block_content": "3. Comma + Coordinating Conjunction Readers are also ready to recognize the end of a grammatical sentence when they see a comma followed by two signals:",
            "block_bbox": [
                80,
                356,
                771,
                405
            ],
            "block_id": 5,
            "block_order": 4,
