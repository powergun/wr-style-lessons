            ]
        },
        {
            "block_label": "text",
            "block_content": "Our society's approach to argument is based on an assumption that competing positions and ideas must always be in conflict (Tannen 284). Recognizing this assumption helps us understand the shrill tone of much talk radio today.",
            "block_bbox": [
