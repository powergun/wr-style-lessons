        },
        {
            "block_label": "text",
            "block_content": "Linguist Deborah Tannen observes that our society's approach to argument is based on an assumption that competing positions and ideas must always be in conflict (284). This view helps us understand the shrill tone of much talk radio today.",
            "block_bbox": [
                125,
                1076,
                755,
                1152
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
