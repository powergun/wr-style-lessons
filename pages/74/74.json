                    525.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This next passage has good cohesive flow because we move from one sentence to the next without a hitch:",
            "block_bbox": [
                79,
                535,
                771,
                585
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    79.0,
                    535.0
                ],
                [
                    771.0,
                    535.0
                ],
                [
                    771.0,
                    585.0
                ],
                [
                    79.0,
                    585.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Sayner, Wisconsin, is the snowmobile capital of the world. The buzzing of snowmobile engines fills the air, and their tank-like tracks crisscross the snow. The snow reminds me of Mom's mashed potatoes, covered with furrows I would draw with my fork. Her mashed potatoes usually make me sick—that's why I play with them. I like to make a hole in the middle of the potatoes and fill it with melted butter. This behavior has been the subject of long chats between my analyst and me.",
            "block_bbox": [
                111,
                598,
                744,
                773
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    111.0,
                    598.0
                ],
                [
                    744.0,
                    598.0
                ],
                [
                    744.0,
                    773.0
                ],
                [
                    111.0,
                    773.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Though its individual sentences are cohesive, that passage as a whole is incoherent. (It was created by six different writers, one of whom wrote the first sentence, with the other five sequentially adding one sentence, knowing only the immediately preceding one.) It is incoherent for three reasons:",
            "block_bbox": [
                78,
                787,
                772,
                890
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    78.0,
                    787.0
                ],
                [
                    772.0,
                    787.0
                ],
                [
                    772.0,
                    890.0
                ],
                [
                    78.0,
                    890.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• The subjects of the sentences are entirely unrelated.",
            "block_bbox": [
                116,
                903,
                572,
                926
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    116.0,
                    903.0
                ],
                [
                    572.0,
                    903.0
                ],
                [
                    572.0,
                    926.0
                ],
                [
                    116.0,
                    926.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- The sentences share no common themes or ideas.",
            "block_bbox": [
                117,
                935,
                563,
                958
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    117.0,
                    935.0
                ],
                [
                    563.0,
                    935.0
                ],
                [
                    563.0,
                    958.0
                ],
                [
                    117.0,
                    958.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- No one sentence states what the whole passage is about.",
            "block_bbox": [
                117,
                967,
                615,
                991
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
