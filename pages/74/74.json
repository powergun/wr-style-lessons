        {
            "block_label": "paragraph_title",
            "block_content": "Coherence",
            "block_bbox": [
                80,
                117,
                219,
                146
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
