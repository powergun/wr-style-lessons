                    117.0,
                    991.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "That second point will be discussed in Lesson 5 and that third one in Lesson 7. The rest of this lesson focuses on the first point: shared subjects.",
            "block_bbox": [
                79,
                1005,
                771,
                1055
            ],
