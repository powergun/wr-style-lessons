                ],
                [
                    79.0,
                    476.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "A Sense of the Whole",
            "block_bbox": [
                80,
                499,
                313,
                525
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
