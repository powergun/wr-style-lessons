                    146.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Your readers want your writing to have cohesive flow because it helps them follow your train of thought. But they also want to feel that your writing is coherent or hangs together as a whole. Coherence is different from cohesion, but it is easy to confuse these words because they sound alike.",
            "block_bbox": [
                78,
                160,
                772,
                263
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    78.0,
                    160.0
                ],
                [
                    772.0,
                    160.0
                ],
                [
                    772.0,
                    263.0
                ],
                [
                    78.0,
                    263.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Cohesion is when pairs of sentences fit together the way two pieces of a jigsaw puzzle do (recall the black hole example).",
            "block_bbox": [
                117,
                277,
                770,
                328
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    117.0,
                    277.0
                ],
                [
                    770.0,
                    277.0
                ],
                [
                    770.0,
                    328.0
                ],
                [
                    117.0,
                    328.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Coherence is when all the sentences in a piece of writing add up to a larger whole, the way all the pieces in a puzzle add up to the picture on the box.",
            "block_bbox": [
                116,
                335,
                771,
                386
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    116.0,
                    335.0
                ],
                [
                    771.0,
                    335.0
                ],
                [
                    771.0,
                    386.0
                ],
                [
                    116.0,
                    386.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In a coherent passage, the sentences will cohere (or connect one to the next), but they will also share something more: a unifying focus that we will call the passage's topic.",
            "block_bbox": [
                79,
                399,
                772,
                476
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    79.0,
