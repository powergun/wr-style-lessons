                    773.0,
                    955.0
                ],
                [
                    773.0,
                    1188.0
                ],
                [
                    78.0,
                    1188.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Charcoal when burned gives off carbon monoxide, which has no odor. Burning charcoal inside homes, vehicles, or tents can cause death.",
