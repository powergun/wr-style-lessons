        {
            "block_label": "vision_footnote",
            "block_content": "NEVER burn charcoal inside homes, vehicles or tents.",
            "block_bbox": [
                372,
                828,
                586,
                868
            ],
            "block_id": 11,
            "block_order": null,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
