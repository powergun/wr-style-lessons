        {
            "block_label": "text",
            "block_content": "an applied problem because it concerns our ignorance about how best to act. Conceptual problems in professional contexts are almost always applied problems. But an applied problem is still a conceptual problem because its solution is not the action itself but the knowledge that enables it.",
            "block_bbox": [
                79,
                117,
                772,
                218
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
