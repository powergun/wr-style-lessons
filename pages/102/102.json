                    117.0
                ],
                [
                    772.0,
                    117.0
                ],
                [
                    772.0,
                    218.0
                ],
                [
                    79.0,
                    218.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Think of it like this: for a conceptual problem, you answer a small question so that your answer contributes to answering a larger, more important one. Readers are motivated because your small question inherits its importance from that larger one.",
            "block_bbox": [
                78,
                221,
                772,
                298
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
