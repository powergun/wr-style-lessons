                ],
                [
                    78.0,
                    298.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Here's the Point",
            "block_bbox": [
                117,
                347,
                352,
                378
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    117.0,
                    347.0
                ],
                [
                    352.0,
