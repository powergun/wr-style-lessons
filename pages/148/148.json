            ]
        },
        {
            "block_label": "text",
            "block_content": "Coordination lets you extend the line of a sentence more gracefully than by tacking on one element to another. When you can coordinate, try to order the elements so that they go from shorter to longer, from simpler to more complex.",
            "block_bbox": [
                116,
                562,
                771,
                634
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
