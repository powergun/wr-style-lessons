                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Here's the Point",
            "block_bbox": [
                118,
                516,
                352,
                548
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
