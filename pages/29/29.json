                    793.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Rephrase in the plural: In English, plural pronouns are gender-neutral and can refer to categories or classes.",
            "block_bbox": [
                114,
                803,
                783,
                852
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
