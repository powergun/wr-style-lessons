        {
            "block_label": "text",
            "block_content": "once that a feminine third-person singular pronoun (she, her, hers) could be used only when its referent was unambiguously female—The mermaid waved her tail—and that the masculine pronoun (he, him, his) should be used in all other cases. But that rule leads to sentences that today seem socially and stylistically awkward:",
            "block_bbox": [
                90,
                117,
                784,
                219
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
