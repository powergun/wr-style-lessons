                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Every student knows that to get good grades, he must take his classes seriously. If someone won't do his work, it is very hard for him to succeed.",
            "block_bbox": [
                124,
                232,
                753,
                281
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    124.0,
                    232.0
                ],
                [
                    753.0,
                    232.0
                ],
                [
                    753.0,
                    281.0
                ],
                [
                    124.0,
                    281.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If, however, we hesitate in formal writing to use they as a singular pronoun, and we also reject he as biased, we are confronted with a delicate problem of style. The thing to remember is that we have choices.",
            "block_bbox": [
                91,
                296,
                784,
                373
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    91.0,
