                [
                    126.0,
                    690.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ A careful writer will always consider the needs of his or her readers.",
            "block_bbox": [
                104,
                701,
                660,
                724
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
