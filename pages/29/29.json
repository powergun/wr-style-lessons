            ]
        },
        {
            "block_label": "text",
            "block_content": "But it can be cumbersome if a sentence contains several pronouns. And this solution is not entirely inclusive, as some people identify as neither male nor female.",
            "block_bbox": [
                115,
                743,
                782,
                793
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
