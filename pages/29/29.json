                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A writer should use gender-neutral language if he wants his readers to see him as modern and progressive.",
            "block_bbox": [
                125,
                862,
                783,
                908
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
