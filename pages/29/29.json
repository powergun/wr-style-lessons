                ],
                [
                    91.0,
                    373.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Pronouns and Gender: Inclusive Options",
            "block_bbox": [
                91,
                399,
                534,
                426
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    91.0,
                    399.0
                ],
                [
                    534.0,
                    399.0
                ],
                [
                    534.0,
                    426.0
                ],
                [
                    91.0,
                    426.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "English may not (yet) have a universally accepted gender-neutral singular third-person pronoun, but it does offer good options to careful writers who want to write in an inclusive fashion. Here are four, in detail.",
            "block_bbox": [
                91,
                434,
                784,
                510
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    91.0,
                    434.0
                ],
                [
                    784.0,
                    434.0
                ],
                [
                    784.0,
                    510.0
                ],
                [
                    91.0,
                    510.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Replace the gendered pronoun with another pronoun or with a noun. In English, only third-person singular pronouns are explicitly gendered, and you can often simply replace them.",
            "block_bbox": [
                91,
                524,
                784,
                600
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    91.0,
                    524.0
                ],
                [
                    784.0,
                    524.0
                ],
                [
                    784.0,
                    600.0
                ],
                [
                    91.0,
                    600.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Use both the masculine and feminine pronouns: You can replace a masculine pronoun with the masculine and feminine pronouns together.",
            "block_bbox": [
                114,
                610,
                783,
                660
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    114.0,
                    610.0
                ],
                [
                    783.0,
                    610.0
                ],
                [
                    783.0,
                    660.0
                ],
                [
                    114.0,
                    660.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A careful writer will always consider the needs of his readers.",
            "block_bbox": [
                126,
                669,
                607,
                691
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
