                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "notorious means known for bad behavior. It does not mean famous. Frank Sinatra was a famous singer but a notorious bully.",
            "block_bbox": [
                127,
                171,
                782,
                218
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
