                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "simplistic does not mean merely simple. It means overly simple and is usually used in a pejorative sense. A simple solution to a problem is often best; a simplistic solution never is.",
            "block_bbox": [
                127,
                225,
                783,
                296
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    127.0,
