        {
            "block_label": "paragraph_title",
            "block_content": "Gender and Style",
            "block_bbox": [
                92,
                785,
                314,
                817
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
