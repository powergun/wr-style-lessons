        {
            "block_label": "text",
            "block_content": "fulsome means sickeningly excessive. It does not mean just much. We all enjoy praise, except when it becomes fulsome.",
            "block_bbox": [
                125,
                116,
                782,
                163
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
