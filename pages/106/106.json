                    146.0,
                    591.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6. Underline your solution/main point/claim. This should appear at the end of the introduction in its stress position and should state the key themes that the rest of your paper will develop (more on that in Lesson 7).",
            "block_bbox": [
                80,
                605,
                772,
                682
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
