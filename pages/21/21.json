                [
                    91.0,
                    168.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Why did the dialect of London become Standard English?",
            "block_bbox": [
                126,
                179,
                577,
                204
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    126.0,
                    179.0
                ],
                [
                    577.0,
                    179.0
                ],
                [
                    577.0,
                    204.0
                ],
                [
                    126.0,
                    204.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Because London was the economic and political center of Great Britain.",
            "block_bbox": [
                128,
                222,
                684,
                246
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    128.0,
                    222.0
                ],
                [
                    684.0,
                    222.0
                ],
                [
                    684.0,
                    246.0
                ],
                [
                    128.0,
                    246.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Quick Tip",
            "block_bbox": [
                130,
                289,
                273,
                322
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    130.0,
                    289.0
                ],
                [
                    273.0,
