        {
            "block_label": "text",
            "block_content": "This bit of folklore probably stems from a schoolhouse restriction intended to discourage sentence fragments in responses to prompts:",
            "block_bbox": [
                91,
                116,
                782,
                168
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
