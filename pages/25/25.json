        {
            "block_label": "text",
            "block_content": "Like became a subordinating conjunction in the eighteenth century when writers began to drop as from the conjunctive phrase like as, leaving just like as the conjunction. This process is called elision, and it is a common linguistic change. It is telling that when editing the second edition of Fowler's Dictionary (the one favored by conservatives), Gowers deleted like for as from Fowler's list of \"Illiteracies\" and moved it into the category of \"Sturdy Indefensibles.\"",
            "block_bbox": [
                91,
                304,
                785,
                458
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
