            ]
        },
        {
            "block_label": "text",
            "block_content": "Phytoplankton biomass in a local pond ecosystem was measured over five-years in our research project. An increase in the pond's energy productivity over this period was suggested by our measurements.",
            "block_bbox": [
                105,
                391,
                783,
                464
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
