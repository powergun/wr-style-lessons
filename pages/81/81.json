            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Begin sentences with subjects or, sometimes, short introductory phrases that communicate old information, information that your readers are familiar with (boldfaced); give new, unfamiliar information (italicized) toward the ends of sentences:",
            "block_bbox": [
                92,
                279,
                784,
                380
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
