        {
            "block_label": "text",
            "block_content": "Writers can put familiar information and unfamiliar information anywhere in a sentence, but readers prefer to find each kind of information in a particular place. Just as readers prefer characters to align with subjects and actions with verbs, so they expect to find old, familiar information toward the beginning of a sentence, aligned with its topic, and new, unfamiliar information toward the end.",
            "block_bbox": [
                90,
                117,
                785,
                244
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
