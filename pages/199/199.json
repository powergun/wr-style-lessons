        {
            "block_label": "text",
            "block_content": "2. Never end an introductory clause or phrase with a semicolon. This rule applies no matter how long that introductory part is and even if it contains internal punctuation. Readers take semicolons to signal the end of a grammatical sentence (but see p. 194 for an exception). Never this:",
            "block_bbox": [
                91,
                191,
                784,
                294
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
