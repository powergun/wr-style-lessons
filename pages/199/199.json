                    91.0,
                    294.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Although the museum possessed a formidable collection of Mesopotamian artifacts, some more than five thousand years old, it could display only a fraction of them. Use a comma there instead:",
            "block_bbox": [
                91,
                303,
                754,
                381
            ],
            "block_id": 5,
            "block_order": 4,
