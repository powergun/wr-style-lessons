                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ Those who are found guilty can be fined.",
            "block_bbox": [
                117,
                385,
                453,
                406
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
