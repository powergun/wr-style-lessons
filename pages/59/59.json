                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ Valuable records should always be kept in a safe.",
            "block_bbox": [
                117,
                413,
                499,
                435
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
