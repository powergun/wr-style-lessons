                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Sometimes, of course, writers use the passive when they don't want readers to know who is responsible for an action:",
            "block_bbox": [
                137,
                531,
                782,
                579
            ],
            "block_id": 9,
