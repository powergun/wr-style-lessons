                    117.0,
                    435.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If we do not know who spreads rumors, we cannot say. And no one doubts who finds people guilty or fines them or who should keep records safe, so we don't have to say. So those passives are the right choice.",
            "block_bbox": [
                115,
                454,
                784,
                529
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
