        },
        {
            "block_label": "paragraph_title",
            "block_content": "How to Revise: Long Openings",
            "block_bbox": [
                80,
                419,
                475,
                453
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
