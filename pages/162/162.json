                    516.0,
                    887.0
                ],
                [
                    129.0,
                    887.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. End with a prepositional phrase introduced by of.",
            "block_bbox": [
                128,
                892,
                518,
                915
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
