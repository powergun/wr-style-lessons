                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An elegant sentence should end on strength. You can create that strength in five ways:",
            "block_bbox": [
                115,
                829,
                755,
                852
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    115.0,
                    829.0
                ],
                [
                    755.0,
                    829.0
                ],
                [
                    755.0,
                    852.0
                ],
                [
                    115.0,
                    852.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. End with a strong word, or better, a pair of them.",
            "block_bbox": [
                129,
                865,
                516,
                887
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
