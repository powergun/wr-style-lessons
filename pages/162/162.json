                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "That sentence (the last one in Fallows's book) opens with three if clauses and ends with a triple coordination. It ends on its longest member, one that itself ends with an of + nominalization (worthy of esteem). Like all such devices, however, the impact of a long suspension is inversely proportional to its frequency of use: the less it's used, the bigger its bang.",
            "block_bbox": [
                79,
                612,
                772,
                741
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
