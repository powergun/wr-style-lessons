                ],
                [
                    79.0,
                    315.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "✓ If one/we/you/researchers are to understand what causes bipolar disorder, one/we/you/they should attend to multiple variables rather than assuming that it depends on a single biological or environmental factor.",
            "block_bbox": [
                90,
                326,
                742,
                401
            ],
            "block_id": 5,
            "block_order": 4,
