                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An understanding of the cause of bipolar disorder requires attention to multiple variables rather than an assumption that the disorder is dependent on a single biological or environmental factor.",
            "block_bbox": [
                114,
                152,
                742,
                226
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    114.0,
