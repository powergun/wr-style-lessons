                ],
                [
                    742.0,
                    152.0
                ],
                [
                    742.0,
                    226.0
                ],
                [
                    114.0,
                    226.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "But when we try to revise that into something clearer, we have to invent characters (gold) and then decide what to call them. Do we use one, we or you? Do we name a generic \"doer\"?",
            "block_bbox": [
                79,
                238,
                772,
                315
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    79.0,
