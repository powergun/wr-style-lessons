        {
            "block_label": "text",
            "block_content": "Who expects? Who recommends? Who revises? Context might help readers guess correctly, but if it is ambiguous, they could guess wrongly.",
            "block_bbox": [
                79,
                116,
                771,
                170
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
