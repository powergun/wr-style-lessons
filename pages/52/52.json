                [
                    79.0,
                    458.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "To get characters into subjects, you have to know three things:",
            "block_bbox": [
                79,
                469,
                608,
                495
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    79.0,
                    469.0
                ],
                [
                    608.0,
                    469.0
                ],
                [
                    608.0,
                    495.0
                ],
                [
                    79.0,
                    495.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. when your subjects are not characters",
            "block_bbox": [
                88,
                507,
                440,
                532
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    88.0,
