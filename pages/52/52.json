                [
                    440.0,
                    532.0
                ],
                [
                    88.0,
                    532.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. if they aren't, where you should look for characters",
            "block_bbox": [
                87,
                539,
                553,
                564
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
