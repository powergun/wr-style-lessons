                    170.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Here's the Point",
            "block_bbox": [
                118,
                215,
                353,
                247
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    118.0,
