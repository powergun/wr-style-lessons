                ],
                [
                    742.0,
                    641.0
                ],
                [
                    742.0,
                    715.0
                ],
                [
                    87.0,
                    715.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We can analyze and revise it according to our procedure from Lesson 2:",
            "block_bbox": [
                79,
                729,
                687,
                754
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    79.0,
