                [
                    87.0,
                    596.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This sentence, for example, feels indirect and impersonal:",
            "block_bbox": [
                79,
                603,
                568,
                628
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    79.0,
                    603.0
                ],
                [
                    568.0,
                    603.0
                ],
                [
                    568.0,
                    628.0
                ],
                [
                    79.0,
                    628.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In most instances, governmental intervention in fast-changing industries leads to a predictable distortion of market evolution and interference in new product development.",
            "block_bbox": [
                87,
                641,
                742,
                715
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    87.0,
