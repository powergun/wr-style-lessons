                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. what you should do when you find them (or don't)",
            "block_bbox": [
                87,
                571,
                553,
                596
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
