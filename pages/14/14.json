            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "How to Use This Book",
            "block_bbox": [
                79,
                790,
                365,
                819
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
