        {
            "block_label": "text",
            "block_content": "something written in an inaccessible style, we too easily assume that its complexity is justified by the complexity and profundity of its ideas. So we try to imitate it, making our already confused writing even worse. Sadder still, some of us become acclimated to that style, learning not only to read it but also to write it, thus inflicting it in turn on our own readers.",
            "block_bbox": [
                79,
                117,
                772,
                244
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
                    79.0,
                    117.0
                ],
                [
                    772.0,
                    117.0
                ],
                [
                    772.0,
                    244.0
