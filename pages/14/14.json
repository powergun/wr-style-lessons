            ]
        },
        {
            "block_label": "text",
            "block_content": "—Nelson Mandela, Nobel Lecture, December 10, 1993",
            "block_bbox": [
                317,
                632,
                741,
                655
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
