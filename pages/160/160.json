        {
            "block_label": "text",
            "block_content": "This seems unlikely, but it's true. Look at how Churchill ends his sentence: the light of (followed by a lighter a or the) quickens the rhythm of a sentence just before the stress of the climactic monosyllable, old:",
            "block_bbox": [
                79,
                528,
                772,
                604
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
