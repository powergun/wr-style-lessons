                    604.0
                ],
                [
                    79.0,
                    604.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "...the rescue and the liberation of the old.",
            "block_bbox": [
                78,
                617,
                443,
                640
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
