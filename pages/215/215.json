            ]
        },
        {
            "block_label": "text",
            "block_content": "You can also let the quotation complete the grammar of your introductory sentence. In that case, punctuate the end of your sentence as if you were running the block quotation into your text:",
            "block_bbox": [
                91,
                285,
                785,
                362
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
