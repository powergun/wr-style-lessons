        },
        {
            "block_label": "text",
            "block_content": "The most common practice, as in that example, is to introduce a block quotation with words that announce it, followed by a period or colon.",
            "block_bbox": [
                91,
                232,
                784,
                282
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
