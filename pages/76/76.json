        {
            "block_label": "text",
            "block_content": "context of each sentence is lost by seemingly random shifts of topics. Unfocused paragraphs result when that happens.",
            "block_bbox": [
                113,
                116,
                742,
                167
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
