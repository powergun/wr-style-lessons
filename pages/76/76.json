            ]
        },
        {
            "block_label": "text",
            "block_content": "Here is how to analyze and revise your writing so it is cohesive and coherent.",
            "block_bbox": [
                79,
                755,
                735,
                779
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
