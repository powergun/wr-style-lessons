            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "1. Analyze",
            "block_bbox": [
                80,
                793,
                184,
                816
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    80.0,
                    793.0
                ],
                [
                    183.0,
                    793.0
                ],
                [
                    183.0,
                    815.0
                ],
                [
                    80.0,
                    815.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Underline the first seven or eight words of every sentence in a passage, stopping when you hit a verb.",
            "block_bbox": [
                102,
                825,
                769,
                875
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    102.0,
                    825.0
                ],
                [
                    769.0,
                    825.0
                ],
                [
                    769.0,
                    875.0
                ],
                [
                    102.0,
                    875.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. If you can, underline the first five or six words of every clause in those sentences.",
            "block_bbox": [
                103,
                877,
                771,
                925
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    103.0,
