            ]
        },
        {
            "block_label": "text",
            "block_content": "Be cautious though: you are more likely to err by striving for variety than by seeming too repetitious.",
            "block_bbox": [
                91,
                646,
                782,
                698
            ],
            "block_id": 7,
            "block_order": 6,
