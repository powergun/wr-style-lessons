                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A “moral climate” is created... This climate results... In this light, it acts... It encourages...",
            "block_bbox": [
                126,
                583,
                754,
                633
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
