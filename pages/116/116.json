        {
            "block_label": "text",
            "block_content": "What are those sentences about spelling, organization, and length doing there? When readers can't see how individual sentences are relevant to a section's overall point, they are likely to find what they read incoherent.",
            "block_bbox": [
                80,
                316,
                771,
                389
            ],
            "block_id": 3,
            "block_order": 2,
