                ],
                [
                    575.0,
                    117.0
                ],
                [
                    575.0,
                    140.0
                ],
                [
                    90.0,
                    140.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Always separate an introductory element from the subject if a reader might misunderstand the structure of the sentence.",
            "block_bbox": [
                117,
                155,
                783,
                203
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    117.0,
                    155.0
                ],
                [
                    783.0,
                    155.0
                ],
                [
                    783.0,
                    203.0
                ],
                [
                    117.0,
                    203.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Never end an introductory clause or phrase with a semicolon.",
            "block_bbox": [
                117,
                207,
                665,
                230
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    117.0,
                    207.0
                ],
                [
                    665.0,
                    207.0
                ],
                [
                    665.0,
                    230.0
                ],
                [
                    117.0,
                    230.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Do not put a comma after a subordinating conjunction if the next element of the clause is its subject.",
            "block_bbox": [
                117,
                234,
                783,
                281
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
                [
                    117.0,
                    234.0
                ],
                [
                    783.0,
                    234.0
                ],
                [
                    783.0,
                    281.0
                ],
                [
                    117.0,
                    281.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Likewise, do not put a comma after a coordinating conjunction if the next element of the clause is its subject.",
            "block_bbox": [
                117,
                285,
                783,
                333
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
                [
                    117.0,
                    285.0
                ],
                [
                    783.0,
                    285.0
                ],
                [
                    783.0,
                    333.0
                ],
                [
                    117.0,
                    333.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Put a comma after a short introductory word or phrase if it comments on the whole of the following sentence or if it connects one sentence to another.",
            "block_bbox": [
                117,
                338,
                783,
                386
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
