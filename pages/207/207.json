                    91.0,
                    526.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Do not interrupt a subject and verb or verb and object with any punctuation, unless absolutely necessary for clarity.",
            "block_bbox": [
                117,
                541,
                782,
                590
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
