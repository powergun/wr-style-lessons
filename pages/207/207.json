                ],
                [
                    117.0,
                    386.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "3. These are strong principles:",
            "block_bbox": [
                91,
                401,
                354,
                425
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
