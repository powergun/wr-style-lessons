            ]
        },
        {
            "block_label": "text",
            "block_content": "• Put a comma after a short introductory phrase or not, as you choose.",
            "block_bbox": [
                116,
                439,
                720,
                463
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
