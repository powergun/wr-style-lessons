        },
        {
            "block_label": "text",
            "block_content": "4. These are reliable rules of internal punctuation. Observe them.",
            "block_bbox": [
                91,
                503,
                646,
                526
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
