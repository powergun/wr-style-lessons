                    782.0,
                    541.0
                ],
                [
                    782.0,
                    590.0
                ],
                [
                    117.0,
                    590.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Inside a clause, always set off long interruptions with paired commas, parentheses, or dashes. Never use semicolons.",
            "block_bbox": [
                117,
                594,
                782,
                641
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
