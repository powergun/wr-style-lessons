                [
                    117.0,
                    641.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Put a comma at the end of an independent clause before a tacked-on subordinate clause when that clause is not essential to the meaning of the sentence.",
            "block_bbox": [
                117,
                645,
                783,
                695
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
