        {
            "block_label": "text",
            "block_content": "2. These are reliable rules of punctuation. Observe them.",
            "block_bbox": [
                90,
                117,
                575,
                140
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "global_block_id": 2,
            "global_group_id": 2,
            "block_polygon_points": [
                [
                    90.0,
