        },
        {
            "block_label": "paragraph_title",
            "block_content": "Exercise 7.2 In Your Own Words",
            "block_bbox": [
                117,
                822,
                579,
                854
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    117.0,
