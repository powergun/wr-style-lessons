                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "The Costs and Benefits of Templated Writing",
            "block_bbox": [
                79,
                349,
                641,
                382
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
