        {
            "block_label": "text",
            "block_content": "Budget your time for both drafting and revising so that you spend most of it on beginnings: the introduction to the whole, then the opening segments of major sections, then the opening segments of subsections and paragraphs, and finally the first words of sentences. Get those beginnings straight, and the rest is likely to take care of itself.",
            "block_bbox": [
                114,
                184,
                771,
                281
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
