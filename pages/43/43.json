            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "How to Revise: Characters and Actions",
            "block_bbox": [
                91,
                319,
                584,
                348
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
