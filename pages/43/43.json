        {
            "block_label": "text",
            "block_content": "My SUGGESTION is that our DISCUSSION of the issue be done with CARE.",
            "block_bbox": [
                199,
                147,
                710,
                170
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
