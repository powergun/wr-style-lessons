                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When you see how a clear sentence can be made unclear, you will better understand why it seemed clear in the first place.",
            "block_bbox": [
                129,
                179,
                782,
                227
            ],
            "block_id": 4,
