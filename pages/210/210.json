        {
            "block_label": "table",
            "block_content": "<table><tr><td>For books, record</td><td>For articles, record</td></tr><tr><td>☐ author(s)</td><td>☐ author(s)</td></tr><tr><td>☐ title (and subtitle)</td><td>☐ title (and subtitle)</td></tr><tr><td>☐ title of series (if any)</td><td>☐ journal, magazine, etc.</td></tr><tr><td>☐ edition or volume (if any)</td><td>☐ volume and issue number</td></tr><tr><td>☐ city and publisher</td><td>☐ online database (if any)</td></tr><tr><td>☐ year published</td><td>☐ date published</td></tr><tr><td>☐ pages for chapter (if any)</td><td>☐ pages for article</td></tr></table>",
