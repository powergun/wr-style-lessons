                    92.0,
                    527.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Rule of Thumb 2: Get to the Verb and Object Quickly",
            "block_bbox": [
                92,
                546,
                660,
                574
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    92.0,
                    546.0
                ],
                [
                    660.0,
                    546.0
                ],
                [
                    660.0,
                    574.0
                ],
                [
                    92.0,
                    574.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Readers also want to get past the main subject to its verb and object. Therefore:",
            "block_bbox": [
                92,
                581,
                760,
                607
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
                [
                    92.0,
                    581.0
                ],
                [
                    760.0,
                    581.0
                ],
                [
                    760.0,
                    607.0
                ],
                [
                    92.0,
                    607.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Avoid long, abstract subjects.",
            "block_bbox": [
                129,
                620,
                399,
                643
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
                [
                    129.0,
                    620.0
                ],
                [
                    399.0,
                    620.0
                ],
                [
                    399.0,
                    643.0
                ],
                [
                    129.0,
                    643.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Avoid interrupting the subject-verb connection.",
            "block_bbox": [
                129,
                652,
                552,
                676
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    129.0,
                    652.0
                ],
                [
                    552.0,
                    652.0
                ],
                [
                    552.0,
                    676.0
                ],
                [
                    129.0,
                    676.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Avoid interrupting the verb-object connection.",
            "block_bbox": [
                129,
                684,
                544,
                708
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
