        {
            "block_label": "text",
            "block_content": "You can find guides to citation in most bookstores or online.",
            "block_bbox": [
                79,
                297,
                590,
                321
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 5,
            "global_group_id": 5,
            "block_polygon_points": [
