                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Because that sentence lets us know in advance what's coming, we feel that the passage is coherent, and we read it with more understanding.",
            "block_bbox": [
                79,
                801,
                770,
                851
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 7,
            "global_group_id": 7,
            "block_polygon_points": [
                [
                    79.0,
                    801.0
                ],
                [
                    770.0,
                    801.0
                ],
                [
                    770.0,
                    851.0
