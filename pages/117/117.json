                    620.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Toward the end of that point sentence, name the key themes that thread through the rest of the paragraph.",
            "block_bbox": [
                125,
                628,
                782,
                678
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 8,
            "global_group_id": 8,
            "block_polygon_points": [
