                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Treat this advice as general guidance, not as a rigid template. Many longer paragraphs don't follow this tidy structure, and we get through them just fine. But even when the first few sentences of a paragraph don't state its point, they still usually introduce its key themes. If the point doesn't appear at the beginning of a paragraph, it will usually come at the end.",
            "block_bbox": [
                90,
                692,
                784,
                821
            ],
            "block_id": 9,
