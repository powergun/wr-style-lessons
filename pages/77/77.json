        },
        {
            "block_label": "text",
            "block_content": "a. In most of your sentences, although not necessarily all, use subjects to name topics.",
            "block_bbox": [
                114,
                149,
                782,
                199
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "global_block_id": 3,
            "global_group_id": 3,
            "block_polygon_points": [
                [
                    114.0,
                    149.0
                ],
                [
                    782.0,
                    149.0
                ],
                [
                    782.0,
                    199.0
                ],
                [
                    114.0,
                    199.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Put these subjects/topics close to the beginnings of your sentences.",
            "block_bbox": [
                116,
                206,
                705,
                230
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 4,
            "global_group_id": 4,
            "block_polygon_points": [
                [
                    116.0,
                    206.0
                ],
                [
                    705.0,
                    206.0
                ],
                [
                    705.0,
