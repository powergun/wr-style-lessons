                ],
                [
                    91.0,
                    972.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "And therefore, it is important to note that, in urban areas since the 1980s...",
            "block_bbox": [
                90,
                985,
                709,
                1008
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
            "global_block_id": 15,
            "global_group_id": 15,
            "block_polygon_points": [
                [
                    90.0,
