                [
                    782.0,
                    897.0
                ],
                [
                    90.0,
                    897.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "And therefore, it is important to note...",
            "block_bbox": [
                90,
                910,
                438,
                933
            ],
            "block_id": 13,
            "block_order": 12,
            "group_id": 13,
            "global_block_id": 13,
            "global_group_id": 13,
            "block_polygon_points": [
                [
                    90.0,
