        {
            "block_label": "paragraph_title",
            "block_content": "Quick Tip",
            "block_bbox": [
                130,
                313,
                273,
                345
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "global_block_id": 6,
            "global_group_id": 6,
            "block_polygon_points": [
