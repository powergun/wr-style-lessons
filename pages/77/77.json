                ],
                [
                    90.0,
                    1008.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Only then do we get to the subject/topic:",
            "block_bbox": [
                91,
                1024,
                444,
                1048
            ],
            "block_id": 16,
            "block_order": 15,
            "group_id": 16,
            "global_block_id": 16,
            "global_group_id": 16,
            "block_polygon_points": [
                [
                    91.0,
