                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Beginning Sentences Well",
            "block_bbox": [
                93,
                595,
                416,
                628
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "global_block_id": 9,
            "global_group_id": 9,
            "block_polygon_points": [
