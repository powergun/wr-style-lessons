                [
                    438.0,
                    933.0
                ],
                [
                    90.0,
                    933.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Then we indicate time, place, or manner:",
            "block_bbox": [
                91,
                948,
                441,
                972
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "global_block_id": 14,
            "global_group_id": 14,
            "block_polygon_points": [
                [
                    91.0,
