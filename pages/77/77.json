                ],
                [
                    116.0,
                    230.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Be sure that those topics are, in context, familiar to your readers.",
            "block_bbox": [
                116,
                233,
                688,
                257
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
