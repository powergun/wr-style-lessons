                ],
                [
                    126.0,
                    1110.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When you open several sentences like that, your readers have a hard time seeing not just what each sentence is about but also the focus of the whole passage. When you find a sentence with lots of words before its subject/topic, revise:",
            "block_bbox": [
                91,
                1124,
                783,
                1202
            ],
            "block_id": 18,
            "block_order": 17,
            "group_id": 18,
            "global_block_id": 18,
            "global_group_id": 18,
            "block_polygon_points": [
                [
                    91.0,
