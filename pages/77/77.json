                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "And therefore, it is important to note that, in urban areas since the 1980s, traffic congestion has steadily increased.",
            "block_bbox": [
                126,
                1061,
                754,
                1110
            ],
            "block_id": 17,
            "block_order": 16,
            "group_id": 17,
            "global_block_id": 17,
            "global_group_id": 17,
            "block_polygon_points": [
                [
                    126.0,
