        },
        {
            "block_label": "text",
            "block_content": "It is hard to begin a sentence well. Readers want to get to a subject/topic quickly, but too often we begin sentences in ways that keep readers from doing that. It's called throat-clearing. Throat-clearing typically begins with metadiscourse (review pp. 51–52) that connects a sentence to the previous one with transitions such as and, but, or therefore:",
            "block_bbox": [
                90,
                640,
                784,
                768
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "global_block_id": 10,
            "global_group_id": 10,
            "block_polygon_points": [
                [
                    90.0,
                    640.0
                ],
                [
                    784.0,
                    640.0
                ],
                [
                    784.0,
                    768.0
                ],
                [
                    90.0,
                    768.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "And therefore...",
            "block_bbox": [
                91,
                781,
                263,
                804
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "global_block_id": 11,
            "global_group_id": 11,
            "block_polygon_points": [
                [
                    91.0,
                    781.0
                ],
                [
                    263.0,
                    781.0
                ],
                [
                    263.0,
                    804.0
                ],
                [
                    91.0,
                    804.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We then add a second kind of metadiscourse that expresses our attitude toward what is coming, words such as fortunately, perhaps, allegedly, it is important to note, for the most part, or in a manner of speaking:",
            "block_bbox": [
                90,
                819,
                782,
                897
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "global_block_id": 12,
            "global_group_id": 12,
            "block_polygon_points": [
                [
                    90.0,
                    819.0
                ],
                [
                    782.0,
                    819.0
